{
  "info": {
    "title": "Google Ads",
    "version": "v19",
    "description": "Simulated Google Ads API for deterministic AutomationBench workflow evaluation."
  },
  "paths": {
    "/customers/{customerId}/campaigns:mutate": {
      "post": {
        "summary": "Apply a batch of create, update, or remove operations across one or more campaigns in a single call.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "resourceName": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "partialFailureError": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "description": "{results: [{resourceName}], partialFailureError?}"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "customerId",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Google Ads customer ID."
          }
        ],
        "description": "Apply a batch of create, update, or remove operations across one or more campaigns in a single call. Request body: Body: {operations: [{create?: Campaign, update?: Campaign, remove?: string (resource name), updateMask?: string}], partialFailure?: boolean, validateOnly?: boolean}.",
        "operationId": "google_ads.campaigns.mutate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "operations": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "create": {
                          "$ref": "#/components/schemas/Campaign"
                        },
                        "remove": {
                          "type": "string"
                        },
                        "update": {
                          "$ref": "#/components/schemas/Campaign"
                        },
                        "updateMask": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "validateOnly": {
                    "type": "boolean"
                  },
                  "partialFailure": {
                    "type": "boolean"
                  }
                },
                "description": "Body: {operations: [{create?: Campaign, update?: Campaign, remove?: string (resource name), updateMask?: string}], partialFailure?: boolean, validateOnly?: boolean}"
              }
            }
          },
          "required": true
        }
      }
    },
    "/customers/{customerId}/googleAds:search": {
      "post": {
        "summary": "Run a GAQL (Google Ads Query Language) query against the account. This environment provides campaign and user-list rows, including their seeded metric fields. Example queries: 'SELECT campaign.id, campaign.name, campaign.status, campaign.advertising_channel_type FROM campaign', 'SELECT user_list.id, user_list.name, user_list.description FROM user_list'.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "adGroup": {
                            "type": "string"
                          },
                          "campaign": {
                            "type": "string"
                          },
                          "userList": {
                            "type": "string"
                          },
                          "...resource fields": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "nextPageToken": {
                      "type": "string"
                    },
                    "totalResultsCount": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "description": "{results: [{campaign?, adGroup?, userList?, ...resource fields}], nextPageToken?, totalResultsCount?}"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "customerId",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Google Ads customer ID — digits only, no dashes."
          }
        ],
        "description": "Run a GAQL (Google Ads Query Language) query against the account. This environment provides campaign and user-list rows, including their seeded metric fields. Example queries: 'SELECT campaign.id, campaign.name, campaign.status, campaign.advertising_channel_type FROM campaign', 'SELECT user_list.id, user_list.name, user_list.description FROM user_list'. Request body: Body: {query: string (required, GAQL query), pageToken?: string}. Google Ads API v19 uses fixed pages of up to 10,000 rows and rejects pageSize..",
        "operationId": "google_ads.googleAds.search",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "query"
                ],
                "properties": {
                  "query": {
                    "type": "string"
                  },
                  "pageToken": {
                    "type": "string"
                  }
                },
                "description": "Body: {query: string (required, GAQL query), pageToken?: string}. Google Ads API v19 uses fixed pages of up to 10,000 rows and rejects pageSize."
              }
            }
          },
          "required": true
        }
      }
    },
    "/customers/{customerId}/campaigns/{campaignId}": {
      "get": {
        "summary": "Fetch a single campaign using its resource name or numeric ID.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "endDate": {
                      "type": "string",
                      "format": "date"
                    },
                    "startDate": {
                      "type": "string",
                      "format": "date"
                    },
                    "resourceName": {
                      "type": "string"
                    },
                    "campaignBudget": {
                      "type": "string"
                    },
                    "advertisingChannelType": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "description": "{resourceName, id, name, status, advertisingChannelType, startDate, endDate, campaignBudget}"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "customerId",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Google Ads customer ID."
          },
          {
            "in": "path",
            "name": "campaignId",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Numeric ID of the campaign to retrieve."
          }
        ],
        "description": "Fetch a single campaign using its resource name or numeric ID.",
        "operationId": "google_ads.campaigns.get"
      }
    },
    "/customers/{customerId}:uploadClickConversions": {
      "post": {
        "summary": "Submit offline click conversion events to Google Ads, matched by gclid (Google click ID). Used to attribute sales or sign-ups that originated from an ad click but were completed outside the browser.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "gclid": {
                            "type": "string"
                          },
                          "conversionAction": {
                            "type": "string"
                          },
                          "conversionDateTime": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "partialFailureError": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "description": "{results: [{gclid, conversionAction, conversionDateTime}], partialFailureError?}"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "customerId",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Google Ads customer ID."
          }
        ],
        "description": "Submit offline click conversion events to Google Ads, matched by gclid (Google click ID). Used to attribute sales or sign-ups that originated from an ad click but were completed outside the browser. Request body: Body: {conversions: [{gclid: string, conversionAction: string (resource name), conversionDateTime: string, conversionValue?: number, currencyCode?: string}], partialFailure?: boolean, validateOnly?: boolean}.",
        "operationId": "google_ads.conversions.uploadClickConversions",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "conversions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "gclid": {
                          "type": "string"
                        },
                        "currencyCode": {
                          "type": "string"
                        },
                        "conversionValue": {
                          "type": "number"
                        },
                        "conversionAction": {
                          "type": "string"
                        },
                        "conversionDateTime": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "validateOnly": {
                    "type": "boolean"
                  },
                  "partialFailure": {
                    "type": "boolean"
                  }
                },
                "description": "Body: {conversions: [{gclid: string, conversionAction: string (resource name), conversionDateTime: string, conversionValue?: number, currencyCode?: string}], partialFailure?: boolean, validateOnly?: boolean}"
              }
            }
          },
          "required": true
        }
      }
    },
    "/customers/{customerId}/offlineUserDataJobs:create": {
      "post": {
        "summary": "Instantiate an offline user data job for adding or removing members in a customer match list. After creating the job, queue operations, then execute the job.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "resourceName": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "description": "{resourceName: string (the job resource name)}"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "customerId",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Google Ads customer ID."
          }
        ],
        "description": "Instantiate an offline user data job for adding or removing members in a customer match list. After creating the job, queue operations, then execute the job. Request body: Body: {job: {type: 'CUSTOMER_MATCH_USER_LIST', customerMatchUserListMetadata: {userList: string (resource name, e.g. 'customers/{customerId}/userLists/{listId}')}}}.",
        "operationId": "google_ads.offlineUserDataJobs.create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "job": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "customerMatchUserListMetadata": {
                        "type": "object",
                        "properties": {
                          "userList": {
                            "type": "object",
                            "properties": {
                              "customerId}/userLists/{listId": {
                                "type": "string"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "description": "Body: {job: {type: 'CUSTOMER_MATCH_USER_LIST', customerMatchUserListMetadata: {userList: string (resource name, e.g. 'customers/{customerId}/userLists/{listId}')}}}"
              }
            }
          },
          "required": true
        }
      }
    },
    "/customers/{customerId}/userLists/{listId}:removeMembers": {
      "post": {
        "summary": "Delete a member (identified by email) from a Google Ads customer match user list. Use this to exclude a contact from a remarketing audience.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "email": {
                      "type": "string",
                      "format": "email"
                    },
                    "list_id": {
                      "type": "string"
                    },
                    "success": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "description": "{success: true, list_id: string, email: string}"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "customerId",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Google Ads customer ID — digits only, no dashes."
          },
          {
            "in": "path",
            "name": "listId",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "ID of the user list (audience) from which the member should be removed."
          }
        ],
        "description": "Delete a member (identified by email) from a Google Ads customer match user list. Use this to exclude a contact from a remarketing audience. Request body: Body: {email: string (required — the email address to remove from the list)}.",
        "operationId": "google_ads.userLists.removeMembers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  }
                },
                "description": "Body: {email: string (required — the email address to remove from the list)}"
              }
            }
          },
          "required": true
        }
      }
    },
