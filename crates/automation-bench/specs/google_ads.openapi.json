                                    "format": "email"
                                  },
                                  "hashedPhoneNumber": {
                                    "type": "string"
                                  }
                                }
                              }
                            }
                          }
                        },
                        "remove": {
                          "type": "object",
                          "properties": {
                            "userIdentifiers": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "hashedEmail": {
                                    "type": "string",
                                    "format": "email"
                                  },
                                  "hashedPhoneNumber": {
                                    "type": "string"
                                  }
                                }
                              }
                            }
                          }
