                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "description": "{name: string (long-running operation resource name)}"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "customerId",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Google Ads customer ID."
          },
          {
            "in": "path",
            "name": "offlineUserDataJobId",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Identifier of the offline user data job to execute."
          }
        ],
        "description": "Trigger execution of an offline user data job to apply its queued operations. This is an asynchronous long-running operation. Request body: Body: {}.",
        "operationId": "google_ads.offlineUserDataJobs.run",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {},
                "description": "Body: {}"
              }
            }
          },
          "required": true
        }
      }
    },
    "/customers/{customerId}/offlineUserDataJobs/{offlineUserDataJobId}:addOperations": {
      "post": {
        "summary": "Enqueue user identifiers to be added or removed as part of an offline user data job.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {}
                }
              }
            },
            "description": "{}"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "customerId",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Google Ads customer ID."
          },
          {
            "in": "path",
            "name": "offlineUserDataJobId",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Identifier of the offline user data job to update."
          }
        ],
        "description": "Enqueue user identifiers to be added or removed as part of an offline user data job. Request body: Body: {operations: [{create?: {userIdentifiers: [{hashedEmail?: string, hashedPhoneNumber?: string}]}, remove?: {userIdentifiers: [{hashedEmail?: string, hashedPhoneNumber?: string}]}}], enablePartialFailure?: boolean}.",
        "operationId": "google_ads.offlineUserDataJobs.addOperations",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "operations": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "create": {
                          "type": "object",
                          "properties": {
                            "userIdentifiers": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "hashedEmail": {
