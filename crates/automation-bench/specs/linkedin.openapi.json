  "components": {
    "schemas": {
      "Job": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "industry": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "apply_url": {
            "type": "string"
          },
          "is_active": {
            "type": "boolean"
          },
          "company_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "company_name": {
            "type": "string"
          },
          "salary_range": {
            "type": "string"
          },
          "workplace_type": {
            "type": "string"
          },
          "employment_type": {
            "type": "string"
          },
          "seniority_level": {
            "type": "string"
          },
          "skills_required": {
            "type": "array",
            "items": {
              "type": "string"
