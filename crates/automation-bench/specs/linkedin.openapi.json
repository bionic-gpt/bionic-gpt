{
  "info": {
    "title": "Linkedin",
    "version": "v2",
    "description": "Simulated Linkedin API for deterministic AutomationBench workflow evaluation."
  },
  "paths": {
    "/me": {
      "get": {
        "summary": "Retrieve the currently authenticated member's profile. Returns profile data including name, headline, location, industry, and contact details.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "phone": {
                      "type": "string"
                    },
                    "success": {
                      "type": "string"
                    },
                    "summary": {
                      "type": "string"
                    },
                    "headline": {
                      "type": "string"
                    },
                    "location": {
                      "type": "string"
                    },
                    "localizedLastName": {
                      "type": "string"
                    },
                    "localizedFirstName": {
                      "type": "string"
                    },
                    "public_profile_url": {
                      "type": "string"
                    },
                    "profile_picture_url": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "description": "{success, id, localizedFirstName, localizedLastName, headline, location, summary, public_profile_url, profile_picture_url, phone}"
          }
        },
        "description": "Retrieve the currently authenticated member's profile. Returns profile data including name, headline, location, industry, and contact details.",
        "operationId": "linkedin.me.get"
      }
    },
    "/people": {
      "get": {
        "summary": "Query LinkedIn profiles using keywords, company, job title, or location. Returns matching profiles from the user's connections and wider network.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "string"
                    },
                    "success": {
                      "type": "string"
                    },
                    "profiles": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Profile"
                      }
                    }
                  }
                }
              }
            },
            "description": "{success, profiles: [Profile], count}"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "keywords",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Search terms matched against name, headline, summary, or email."
          },
          {
            "in": "query",
            "name": "company",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Narrow results to profiles at this company."
          },
          {
            "in": "query",
            "name": "title",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Narrow results by job title."
          },
          {
            "in": "query",
            "name": "location",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Narrow results by geographic location."
          },
          {
            "in": "query",
            "name": "count",
            "schema": {
              "type": "integer"
            },
            "required": false,
            "description": "Maximum profiles to return (default 10)."
          }
        ],
        "description": "Query LinkedIn profiles using keywords, company, job title, or location. Returns matching profiles from the user's connections and wider network.",
        "operationId": "linkedin.people.search"
      }
    },
    "/messages": {
      "post": {
        "summary": "Deliver a direct message to a LinkedIn connection. Identify the recipient by profile ID, email, profile URL, or a recipients array.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "$ref": "#/components/schemas/Message"
                    },
                    "success": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "description": "{success, message: Message}"
          }
        },
        "description": "Deliver a direct message to a LinkedIn connection. Identify the recipient by profile ID, email, profile URL, or a recipients array. Request body: Body: {text or body (required, string — message text), profile_id (string — recipient profile ID), email (string — recipient email address), profile_url (string — recipient profile URL), recipients (array of person URN strings e.g. ['urn:li:person:{id}']), subject (optional, string — conversation title)}. Provide at least one of profile_id, email, profile_url, or recipients to identify the recipient..",
        "operationId": "linkedin.messages.create",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "text or body"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "subject": {
                    "type": "string"
                  },
                  "profile_id": {
                    "type": "string",
                    "format": "binary"
                  },
                  "profile_url": {
                    "type": "string",
                    "format": "binary"
                  },
                  "text or body": {
                    "type": "string"
                  },
                  "recipients (array of person URN strings e.g. ['urn": {
                    "type": "object",
                    "properties": {
                      "id}'": {
                        "type": "string"
                      }
                    }
                  }
                },
                "description": "Body: {text or body (required, string — message text), profile_id (string — recipient profile ID), email (string — recipient email address), profile_url (string — recipient profile URL), recipients (array of person URN strings e.g. ['urn:li:person:{id}']), subject (optional, string — conversation title)}. Provide at least one of profile_id, email, profile_url, or recipients to identify the recipient."
              }
            }
          },
          "required": true
        }
      }
    },
    "/ugcPosts": {
      "get": {
        "summary": "Locate UGC posts by author. The official API accepts q=authors with an authors=List(URN) parameter. This endpoint additionally supports filtering by author profile ID or matching against post text.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "string"
                    },
                    "posts": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Post"
                      }
                    },
                    "success": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "description": "{success, posts: [Post], count}"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Query mode — use 'authors' to retrieve posts from a specific author."
          },
          {
            "in": "query",
            "name": "author",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Restrict posts to this author's profile ID."
          },
          {
            "in": "query",
            "name": "sortBy",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Ordering criterion. Enum: 'CREATED'|'LAST_MODIFIED'. Default: LAST_MODIFIED."
          }
        ],
        "description": "Locate UGC posts by author. The official API accepts q=authors with an authors=List(URN) parameter. This endpoint additionally supports filtering by author profile ID or matching against post text.",
        "operationId": "linkedin.ugcPosts.search"
      },
      "post": {
        "summary": "Publish a UGC post or article on behalf of the authenticated user. Accepts both the standard LinkedIn UGC nested format and a simplified flat parameter format.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "post": {
                      "$ref": "#/components/schemas/Post"
                    },
                    "author": {
                      "type": "string"
                    },
                    "success": {
                      "type": "string"
                    },
                    "visibility": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "description": "{success, post: Post, id, author, visibility}"
          }
        },
        "description": "Publish a UGC post or article on behalf of the authenticated user. Accepts both the standard LinkedIn UGC nested format and a simplified flat parameter format. Request body: Body: Standard LinkedIn format: {author (required, string — URN e.g. urn:li:person:{id} or urn:li:organization:{id}), lifecycleState (required, string — must be 'PUBLISHED'), specificContent: {'com.linkedin.ugc.ShareContent': {shareCommentary: {text (required, string — post text, max 3000 chars)}, shareMediaCategory (required, string — 'NONE'|'ARTICLE'|'IMAGE'|'VIDEO'|'RICH'|'CAROUSEL'|'NATIVE_DOCUMENT'|'LIVE_VIDEO')}}, visibility: {'com.linkedin.ugc.MemberNetworkVisibility': 'PUBLIC'|'CONNECTIONS'|'LOGGED_IN'}}. Simplified format: {comment (string — post text), visibility__code ('PUBLIC' or 'CONNECTIONS'), content__title, content__description, content__submitted_url, content__submitted_image_url}.",
        "operationId": "linkedin.ugcPosts.create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "lifecycleState",
                  "specificContent"
                ],
                "properties": {
                  "visibility": {
                    "type": "object",
                    "properties": {
                      "'com.linkedin.ugc.MemberNetworkVisibility'": {
                        "type": "string"
                      }
                    }
                  },
                  "content__title": {
                    "type": "string"
                  },
                  "lifecycleState": {
                    "type": "string"
                  },
                  "specificContent": {
                    "type": "object",
                    "required": [
                      "'com.linkedin.ugc.ShareContent'"
                    ],
                    "properties": {
                      "'com.linkedin.ugc.ShareContent'": {
                        "type": "object",
                        "required": [
                          "shareCommentary",
                          "shareMediaCategory"
                        ],
                        "properties": {
                          "shareCommentary": {
                            "type": "object",
                            "required": [
                              "text"
                            ],
                            "properties": {
                              "text": {
                                "type": "string"
                              }
                            }
                          },
                          "shareMediaCategory": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  },
                  "visibility__code": {
                    "type": "string"
                  },
                  "content__description": {
                    "type": "string"
                  },
                  "content__submitted_url": {
                    "type": "string"
                  },
                  "content__submitted_image_url": {
                    "type": "string"
                  },
                  "author (required, string — URN e.g. urn": {
                    "type": "object",
                    "properties": {
                      "id} or urn": {
                        "type": "string"
                      }
                    }
                  }
                },
                "description": "Body: Standard LinkedIn format: {author (required, string — URN e.g. urn:li:person:{id} or urn:li:organization:{id}), lifecycleState (required, string — must be 'PUBLISHED'), specificContent: {'com.linkedin.ugc.ShareContent': {shareCommentary: {text (required, string — post text, max 3000 chars)}, shareMediaCategory (required, string — 'NONE'|'ARTICLE'|'IMAGE'|'VIDEO'|'RICH'|'CAROUSEL'|'NATIVE_DOCUMENT'|'LIVE_VIDEO')}}, visibility: {'com.linkedin.ugc.MemberNetworkVisibility': 'PUBLIC'|'CONNECTIONS'|'LOGGED_IN'}}. Simplified format: {comment (string — post text), visibility__code ('PUBLIC' or 'CONNECTIONS'), content__title, content__description, content__submitted_url, content__submitted_image_url}"
              }
            }
          },
          "required": true
        }
      }
    },
    "/connections": {
      "get": {
        "summary": "Retrieve the authenticated member's first-degree connections. Optionally filter by keywords matching name, headline, or company.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "paging": {
                      "type": "object",
                      "properties": {
                        "count": {
                          "type": "string"
                        },
                        "start": {
                          "type": "string"
                        },
                        "total": {
                          "type": "string"
                        }
                      }
                    },
                    "elements": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "to": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "description": "{elements: [{to: 'urn:li:person:xxx'}], paging: {count, start, total}}"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Query type — use 'viewer' to fetch the authenticated member's connections."
          },
          {
            "in": "query",
            "name": "keywords",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Restrict connections by name, headline, or company."
          },
          {
            "in": "query",
            "name": "start",
            "schema": {
              "type": "integer"
            },
            "required": false,
            "description": "Starting offset for pagination (default 0)."
          },
          {
            "in": "query",
            "name": "count",
            "schema": {
              "type": "integer"
            },
            "required": false,
            "description": "Connections to return per page (default 50, recommended max 50)."
          }
        ],
        "description": "Retrieve the authenticated member's first-degree connections. Optionally filter by keywords matching name, headline, or company.",
        "operationId": "linkedin.connections.list"
      }
    },
    "/invitations": {
      "post": {
        "summary": "Dispatch a connection invitation to another LinkedIn member. Identify the recipient by profile URL, profile ID, or invitee identifier. Sending duplicate invitations to the same profile will be rejected.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "sent_at": {
                      "type": "string"
                    },
                    "success": {
                      "type": "string"
                    },
                    "profile_url": {
                      "type": "string"
                    },
                    "invitation_id": {
                      "type": "string"
                    },
                    "invitation_type": {
                      "type": "string"
                    },
                    "sender_profile_id": {
                      "type": "string"
                    },
                    "recipient_profile_url": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "description": "{success, id, invitation_id, profile_url, status ('sent'), sent_at, message, invitation_type, sender_profile_id, recipient_profile_url}"
          }
        },
        "description": "Dispatch a connection invitation to another LinkedIn member. Identify the recipient by profile URL, profile ID, or invitee identifier. Sending duplicate invitations to the same profile will be rejected. Request body: Body: {profile_url or invitee_url or invitee (required, string — target LinkedIn profile URL or profile ID), message (optional, string — custom invitation note), tracking_token (optional, string)}.",
        "operationId": "linkedin.invitations.create",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "profile_url or invitee_url or invitee"
                ],
                "properties": {
                  "message": {
                    "type": "string"
                  },
                  "tracking_token": {
                    "type": "string"
                  },
                  "profile_url or invitee_url or invitee": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "description": "Body: {profile_url or invitee_url or invitee (required, string — target LinkedIn profile URL or profile ID), message (optional, string — custom invitation note), tracking_token (optional, string)}"
              }
            }
          },
          "required": true
        }
      }
    },
