{
  "info": {
    "title": "Gmail",
    "x-logo": {
      "url": "https://cdn.simpleicons.org/gmail"
    },
    "version": "v1",
    "description": "Gmail mailbox, message, draft, label, and thread operations."
  },
  "paths": {
    "/gmail/v1/users/{userId}/drafts": {
      "get": {
        "summary": "List all saved drafts in the user's mailbox.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "description": "ListDraftsResponse: {drafts: [{id, message: {id, threadId}}], resultSizeEstimate: int}"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "userId",
            "schema": {
              "type": "string",
              "default": "me"
            },
            "required": true
          },
          {
            "in": "query",
            "name": "maxResults",
            "schema": {
              "type": "integer"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "includeSpamTrash",
            "schema": {
              "type": "boolean"
            },
            "required": false,
            "description": "When true, also includes drafts from SPAM and TRASH."
          },
          {
            "in": "query",
            "name": "pageToken",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Page token returned by a previous list request."
          }
        ],
        "description": "List all saved drafts in the user's mailbox.",
        "operationId": "gmail.users.drafts.list"
      },
      "post": {
        "summary": "Store a new message as an unsent draft in the mailbox.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "description": "Draft: {id, message: {id, threadId, labelIds: [DRAFT]}}"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "userId",
            "schema": {
              "type": "string",
              "default": "me"
            },
            "required": true
          }
        ],
        "description": "Store a new message as an unsent draft in the mailbox.",
        "operationId": "gmail.users.drafts.create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Draft"
              }
            }
          },
          "required": true
        }
      }
    },
