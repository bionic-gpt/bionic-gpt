    "/gmail/v1/users/{userId}/threads": {
      "get": {
        "summary": "List conversation threads from the user's mailbox.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "description": "ListThreadsResponse: {threads: [{id, snippet, historyId}], resultSizeEstimate: int}"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "userId",
            "schema": {
              "type": "string",
              "default": "me"
            },
            "required": true
          },
          {
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "labelIds",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "required": false,
            "description": "Restrict results to threads carrying all of the specified label IDs."
          },
          {
            "in": "query",
            "name": "maxResults",
            "schema": {
              "type": "integer"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "includeSpamTrash",
            "schema": {
              "type": "boolean"
            },
            "required": false,
            "description": "When true, also includes threads from SPAM and TRASH."
          },
          {
            "in": "query",
            "name": "pageToken",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Page token returned by a previous list request."
          }
        ],
        "description": "List conversation threads from the user's mailbox.",
        "operationId": "gmail.users.threads.list"
      }
    },
    "/gmail/v1/users/{userId}/messages": {
      "get": {
        "summary": "Retrieve messages from the user's mailbox, optionally narrowed by label, sender, subject, or a search query.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListMessagesResponse"
                }
              }
            },
            "description": "ListMessagesResponse: {messages: [{id, threadId}], resultSizeEstimate: int}"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "userId",
            "schema": {
              "type": "string",
              "default": "me"
            },
            "required": true,
            "description": "The user's email address. Use 'me' to refer to the authenticated user."
          },
          {
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Filter messages by a query string. Supports Gmail search operators (from:, to:, subject:, is:unread, label:, etc.)."
          },
          {
            "in": "query",
            "name": "labelIds",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "required": false,
            "description": "Restrict results to messages that carry all of the specified label IDs."
          },
          {
            "in": "query",
            "name": "maxResults",
            "schema": {
              "type": "integer"
            },
            "required": false,
            "description": "Upper limit on messages to return (default 100, max 500)."
          },
          {
            "in": "query",
            "name": "includeSpamTrash",
            "schema": {
              "type": "boolean"
            },
            "required": false,
            "description": "When true, also returns messages from the SPAM and TRASH folders."
          },
          {
            "in": "query",
            "name": "pageToken",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Page token returned by a previous list request."
          }
        ],
        "description": "Retrieve messages from the user's mailbox, optionally narrowed by label, sender, subject, or a search query.",
        "operationId": "gmail.users.messages.list"
      }
    },
