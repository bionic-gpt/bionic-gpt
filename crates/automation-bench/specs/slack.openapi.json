{
  "info": {
    "title": "Slack",
    "x-logo": {
      "url": "https://cdn.simpleicons.org/slack"
    },
    "version": "web-api-2025",
    "description": "Simulated Slack API for deterministic messaging workflow evaluations."
  },
  "paths": {
    "/users.info": {
      "get": {
        "summary": "Retrieve the profile and account details for a single Slack user.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            },
            "description": "Structured response"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "user",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "ID of the user to look up."
          },
          {
            "in": "query",
            "name": "include_locale",
            "schema": {
              "type": "boolean"
            },
            "required": false,
            "description": "When true, the user's locale is included in the response (default false)."
          }
        ],
        "description": "Retrieve the profile and account details for a single Slack user.",
        "operationId": "slack.users.info"
      }
    },
    "/users.list": {
      "get": {
        "summary": "Enumerate all members of a Slack workspace. Useful for locating a user by display name or real name when their email or ID is unknown.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "members": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/User"
                      }
                    }
                  }
                }
              }
            },
            "description": "Structured response"
          }
        },
        "description": "Enumerate all members of a Slack workspace. Useful for locating a user by display name or real name when their email or ID is unknown.",
        "operationId": "slack.users.list"
      }
    },
    "/chat.delete": {
      "post": {
        "summary": "Permanently remove a previously posted message from a channel.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "ts": {
                      "type": "string"
                    },
                    "channel": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "description": "Structured response"
          }
        },
        "description": "Permanently remove a previously posted message from a channel.",
        "operationId": "slack.chat.delete",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "channel",
                  "ts"
                ],
                "properties": {
                  "ts": {
                    "type": "string",
                    "description": "Timestamp identifying the message to delete."
                  },
                  "channel": {
                    "type": "string",
                    "description": "Channel containing the message to delete."
                  }
                }
              }
            }
          },
          "required": true
        }
      }
    },
    "/chat.update": {
      "post": {
        "summary": "Change the text or block content of a previously posted message.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "ts": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    },
                    "channel": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "description": "Structured response"
          }
        },
        "description": "Change the text or block content of a previously posted message.",
        "operationId": "slack.chat.update",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "channel",
                  "ts"
                ],
                "properties": {
                  "ts": {
                    "type": "string",
                    "description": "Timestamp identifying the message to update."
                  },
                  "text": {
                    "type": "string",
                    "description": "Replacement text for the message. Required when blocks and attachments are not supplied."
                  },
                  "parse": {
                    "type": "string",
                    "description": "Controls message text processing: 'none' or 'full'."
                  },
                  "blocks": {
                    "type": "array",
                    "description": "Replacement Block Kit layout elements as a JSON array."
                  },
                  "channel": {
                    "type": "string",
                    "description": "Channel where the message to be changed was posted."
                  },
                  "attachments": {
                    "type": "array",
                    "description": "Replacement legacy attachments as a JSON array."
                  }
                }
              }
            }
          },
          "required": true
        }
      }
    },
    "/reactions.add": {
      "post": {
        "summary": "Attach an emoji reaction to a message.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  }
                }
              }
            },
            "description": "Structured response"
          }
        },
        "description": "Attach an emoji reaction to a message.",
        "operationId": "slack.reactions.add",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "channel",
                  "timestamp",
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Emoji name to use as the reaction, without surrounding colons (e.g. 'thumbsup')."
                  },
                  "channel": {
                    "type": "string",
                    "description": "Channel where the target message was posted."
                  },
                  "timestamp": {
                    "type": "string",
                    "description": "Timestamp of the message to react to."
                  }
                }
              }
            }
          },
          "required": true
        }
      }
    },
    "/reactions.get": {
      "get": {
        "summary": "Retrieve all emoji reactions on a message.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "message": {
                      "$ref": "#/components/schemas/Message"
                    }
                  }
                }
              }
            },
            "description": "Structured response"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "channel",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Channel where the target message was posted."
          },
          {
            "in": "query",
            "name": "timestamp",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Timestamp of the message whose reactions to retrieve."
          },
          {
            "in": "query",
            "name": "full",
            "schema": {
              "type": "boolean"
            },
            "required": false,
            "description": "When true, returns the complete list of reacting users."
          }
        ],
        "description": "Retrieve all emoji reactions on a message.",
        "operationId": "slack.reactions.get"
      }
    },
    "/search.messages": {
      "get": {
        "summary": "Search across messages in the workspace matching a query. Supports in:channel and from:user modifier syntax.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "messages": {
                      "type": "object",
                      "properties": {
                        "total": {
                          "type": "string"
                        },
                        "matches": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Message"
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "description": "Structured response"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "query",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Search expression. Supports in:channel_name and from:user_id modifiers."
          },
          {
            "in": "query",
            "name": "sort",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Sort matching messages by 'score' or 'timestamp' (default 'score')."
          },
          {
            "in": "query",
            "name": "sort_dir",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Sort direction: 'asc' or 'desc' (default 'desc')."
          },
          {
            "in": "query",
            "name": "count",
            "schema": {
              "type": "integer"
            },
            "required": false,
            "description": "Results per page (max 100, default 20)."
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer"
            },
            "required": false,
            "description": "Page of results to return (default 1)."
          },
          {
            "in": "query",
            "name": "highlight",
            "schema": {
              "type": "boolean"
            },
            "required": false,
            "description": "When true, matched terms are highlighted in the returned text."
          }
        ],
        "description": "Search across messages in the workspace matching a query. Supports in:channel and from:user modifier syntax.",
        "operationId": "slack.search.messages"
      }
    },
    "/chat.postMessage": {
      "post": {
        "summary": "Send a new message to a channel or direct message. Include thread_ts to post as a reply within an existing thread.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "ts": {
                      "type": "string"
                    },
                    "channel": {
                      "type": "string"
                    },
                    "message": {
                      "$ref": "#/components/schemas/Message"
                    }
                  }
                }
              }
            },
            "description": "Structured response"
          }
        },
        "description": "Send a new message to a channel or direct message. Include thread_ts to post as a reply within an existing thread.",
        "operationId": "slack.chat.postMessage",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "channel"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "description": "Message body text. Required when no blocks or attachments are provided."
                  },
                  "parse": {
                    "type": "string",
                    "description": "Controls message text processing: 'none' or 'full'."
                  },
                  "blocks": {
                    "type": "array",
                    "description": "Structured Block Kit layout elements as a JSON array."
                  },
                  "mrkdwn": {
                    "type": "boolean",
                    "description": "Set false to disable Slack's markdown-style text formatting (default true)."
                  },
                  "channel": {
                    "type": "string",
                    "description": "Destination channel, private group, or IM. Can be an encoded ID or a channel name."
                  },
                  "icon_url": {
                    "type": "string",
                    "description": "Image URL to use as the message icon."
                  },
                  "username": {
                    "type": "string",
                    "description": "Override the bot's display name for this message (requires chat:write.customize scope)."
                  },
                  "thread_ts": {
                    "type": "string",
                    "description": "Timestamp of another message; supply this to make the post a thread reply."
                  },
                  "icon_emoji": {
                    "type": "string",
                    "description": "Emoji to display as the message icon (e.g. :chart_with_upwards_trend:)."
                  },
                  "attachments": {
                    "type": "array",
                    "description": "Legacy secondary message attachments as a JSON array."
                  },
                  "unfurl_links": {
                    "type": "boolean",
                    "description": "Enables link preview expansion for text-based URLs (default false)."
                  },
                  "unfurl_media": {
                    "type": "boolean",
                    "description": "Controls media URL expansion; set false to suppress it (default true)."
                  },
                  "reply_broadcast": {
                    "type": "boolean",
                    "description": "When used with thread_ts and set true, also posts the reply to the main channel (default false)."
                  }
                }
              }
            }
          },
          "required": true
        }
      }
    },
    "/users.profile.set": {
      "post": {
        "summary": "Update profile fields for a user, such as status text and emoji.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "profile": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                }
              }
            },
            "description": "Structured response"
          }
        },
        "description": "Update profile fields for a user, such as status text and emoji.",
        "operationId": "slack.users.profile.set",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Name of a single profile field to set (alternative to supplying the full profile object)."
                  },
                  "user": {
                    "type": "string",
                    "description": "ID of the user whose profile to update (admin only). Defaults to the authenticated user."
                  },
                  "value": {
                    "type": "string",
                    "description": "Value to assign to the single profile field specified by name."
                  },
                  "profile": {
                    "type": "object",
                    "description": "Object containing profile fields to update (e.g. status_text, status_emoji, status_expiration)."
                  }
                }
              }
            }
          },
          "required": false
        }
      }
    },
    "/conversations.info": {
      "get": {
        "summary": "Fetch details about a specific conversation. Returns a channel object including topic, purpose, member count, and archive status.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "channel": {
                      "$ref": "#/components/schemas/Channel"
                    }
                  }
                }
              }
            },
            "description": "Structured response"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "channel",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "ID of the conversation to look up."
          },
          {
            "in": "query",
            "name": "include_locale",
            "schema": {
              "type": "boolean"
            },
            "required": false,
            "description": "Set true to include the locale for this conversation (default false)."
          },
          {
            "in": "query",
            "name": "include_num_members",
            "schema": {
              "type": "boolean"
            },
            "required": false,
            "description": "Set true to include the member count in the response (default false)."
          }
        ],
        "description": "Fetch details about a specific conversation. Returns a channel object including topic, purpose, member count, and archive status.",
        "operationId": "slack.conversations.info"
      }
    },
    "/conversations.list": {
      "get": {
        "summary": "Fetch all conversations in a Slack workspace, paginated and limited by the token's granted scopes.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "channels": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Channel"
                      }
                    },
                    "response_metadata": {
                      "type": "object",
                      "properties": {
                        "next_cursor": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            },
            "description": "Structured response"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "exclude_archived",
            "schema": {
              "type": "boolean"
            },
            "required": false,
            "description": "If true, archived conversations are excluded from results (default false)."
          },
          {
            "in": "query",
            "name": "types",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Comma-separated channel type filter: public_channel, private_channel, mpim, im (default 'public_channel')."
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer"
            },
            "required": false,
            "description": "Maximum items per page (hard max 1000, recommended 200 or fewer)."
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Pagination cursor taken from response_metadata.next_cursor."
          },
          {
            "in": "query",
            "name": "team_id",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Workspace ID, required only when using an org-level token."
          }
        ],
        "description": "Fetch all conversations in a Slack workspace, paginated and limited by the token's granted scopes.",
        "operationId": "slack.conversations.list"
      }
    },
    "/conversations.open": {
      "post": {
        "summary": "Open or resume a direct message or multi-person DM. Use this to obtain a DM channel ID before sending a message with chat.postMessage.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "channel": {
                      "$ref": "#/components/schemas/Channel"
                    }
                  }
                }
              }
            },
            "description": "Structured response"
          }
        },
        "description": "Open or resume a direct message or multi-person DM. Use this to obtain a DM channel ID before sending a message with chat.postMessage.",
        "operationId": "slack.conversations.open",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "users": {
                    "type": "string",
                    "description": "Comma-separated list of user IDs. A single ID opens a DM; multiple IDs open or resume an MPIM."
                  },
                  "channel": {
                    "type": "string",
                    "description": "ID of an existing IM or MPIM channel to resume."
                  },
                  "return_im": {
                    "type": "boolean",
                    "description": "When true, the response includes the full IM channel definition."
                  }
                }
              }
            }
          },
          "required": false
        }
      }
    },
    "/users.lookupByEmail": {
      "get": {
        "summary": "Look up a workspace member using their email address. Requires the users:read.email scope.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            },
            "description": "Structured response"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "email",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Email address of the workspace member to find."
          }
        ],
        "description": "Look up a workspace member using their email address. Requires the users:read.email scope.",
        "operationId": "slack.users.lookupByEmail"
      }
    },
    "/conversations.create": {
      "post": {
        "summary": "Create a new public or private Slack channel. Names must use lowercase letters, numbers, hyphens, and underscores only (max 80 characters).",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "channel": {
                      "$ref": "#/components/schemas/Channel"
                    }
                  }
                }
              }
            },
            "description": "Structured response"
          }
        },
        "description": "Create a new public or private Slack channel. Names must use lowercase letters, numbers, hyphens, and underscores only (max 80 characters).",
        "operationId": "slack.conversations.create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Desired name for the new channel."
                  },
                  "team_id": {
                    "type": "string",
                    "description": "Workspace ID, required only when using an org-level token."
                  },
                  "is_private": {
                    "type": "boolean",
                    "description": "Set true to create a private channel rather than a public one (default false)."
                  }
                }
              }
            }
          },
          "required": true
        }
      }
    },
    "/conversations.invite": {
      "post": {
        "summary": "Add between 1 and 100 users to a public or private channel. The caller must already be a member of the channel.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "channel": {
                      "$ref": "#/components/schemas/Channel"
                    }
                  }
                }
              }
            },
            "description": "Structured response"
          }
        },
        "description": "Add between 1 and 100 users to a public or private channel. The caller must already be a member of the channel.",
        "operationId": "slack.conversations.invite",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "channel",
                  "users"
                ],
                "properties": {
                  "force": {
                    "type": "boolean",
                    "description": "When true and multiple users are supplied, continue inviting remaining users even if one fails."
                  },
                  "users": {
                    "type": "string",
                    "description": "Comma-separated list of user IDs to invite (up to 100)."
                  },
                  "channel": {
                    "type": "string",
                    "description": "ID of the channel to which users should be added."
                  }
                }
              }
            }
          },
          "required": true
        }
      }
    },
    "/conversations.archive": {
      "post": {
        "summary": "Archive a channel or DM to prevent any further messages from being posted. Not supported for all conversation types.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  }
                }
              }
            },
            "description": "Structured response"
          }
        },
        "description": "Archive a channel or DM to prevent any further messages from being posted. Not supported for all conversation types.",
        "operationId": "slack.conversations.archive",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "channel"
                ],
                "properties": {
                  "channel": {
                    "type": "string",
                    "description": "ID of the conversation to archive."
                  }
                }
              }
            }
          },
          "required": true
        }
      }
    },
    "/conversations.history": {
      "get": {
        "summary": "Fetch previous messages and events from a channel or conversation. Results are returned newest-first.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "has_more": {
                      "type": "boolean"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Message"
                      }
                    },
                    "response_metadata": {
                      "type": "object",
                      "properties": {
                        "next_cursor": {
