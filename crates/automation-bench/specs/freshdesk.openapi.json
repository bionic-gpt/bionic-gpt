{
  "info": {
    "title": "Freshdesk",
    "version": "v2",
    "description": "Simulated Freshdesk API for deterministic AutomationBench workflow evaluation."
  },
  "paths": {
    "/api/v2/tickets": {
      "get": {
        "summary": "Retrieve all tickets from the helpdesk. Fetches open, pending, resolved, and closed support cases and issues.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "description": "[Ticket] (JSON array of ticket objects)"
          }
        },
        "description": "Retrieve all tickets from the helpdesk. Fetches open, pending, resolved, and closed support cases and issues.",
        "operationId": "freshdesk.tickets.list"
      },
      "post": {
        "summary": "Submit a new support ticket to the helpdesk. Specify the subject, description, priority, status, and assigned agent when opening the ticket.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "description": "Ticket object"
          }
        },
        "description": "Submit a new support ticket to the helpdesk. Specify the subject, description, priority, status, and assigned agent when opening the ticket. Request body: {subject, description?, status?, priority?, type?, requester_id?, email?, responder_id?, tags?}.",
        "operationId": "freshdesk.tickets.create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "tags": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "status": {
                    "type": "string"
                  },
                  "subject": {
                    "type": "string"
                  },
                  "priority": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "requester_id": {
                    "type": "string"
                  },
                  "responder_id": {
                    "type": "string"
                  }
                },
                "description": "{subject, description?, status?, priority?, type?, requester_id?, email?, responder_id?, tags?}"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/v2/contacts": {
      "get": {
        "summary": "Retrieve all contacts (customers and requesters) stored in Freshdesk.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "description": "ListContactsResponse: {contacts: [Contact], count: int}"
          }
        },
        "description": "Retrieve all contacts (customers and requesters) stored in Freshdesk.",
        "operationId": "freshdesk.contacts.list"
      },
      "post": {
        "summary": "Register a new contact in Freshdesk. Use this to add a customer, requester, or any person to the system.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "description": "Contact object"
          }
        },
        "description": "Register a new contact in Freshdesk. Use this to add a customer, requester, or any person to the system. Request body: {name, email?, phone?, mobile?, company_id?, job_title?, description?, tags?}.",
        "operationId": "freshdesk.contacts.create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "mobile": {
                    "type": "string"
                  },
                  "job_title": {
                    "type": "string"
                  },
                  "company_id": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  }
                },
                "description": "{name, email?, phone?, mobile?, company_id?, job_title?, description?, tags?}"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/v2/companies": {
      "post": {
        "summary": "Add a new company (organization or business account) to Freshdesk.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "description": "Company object"
          }
        },
        "description": "Add a new company (organization or business account) to Freshdesk. Request body: {name, description?, domains?, note?}.",
        "operationId": "freshdesk.companies.create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "note": {
                    "type": "string"
                  },
                  "domains": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  }
                },
                "description": "{name, description?, domains?, note?}"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/v2/tickets/{id}": {
      "get": {
        "summary": "Fetch a single ticket by its ID. Use this to look up a specific support case or issue.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "description": "Ticket object"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "The unique identifier of the ticket to fetch."
          }
        ],
        "description": "Fetch a single ticket by its ID. Use this to look up a specific support case or issue.",
        "operationId": "freshdesk.tickets.get"
      },
      "put": {
        "summary": "Modify an existing support ticket. Update fields such as status, priority, assigned agent, group, tags, subject, or description.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "description": "Ticket object"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "The unique identifier of the ticket to update."
          }
        ],
        "description": "Modify an existing support ticket. Update fields such as status, priority, assigned agent, group, tags, subject, or description. Request body: {subject?, description?, status?, priority?, type?, responder_id?, group_id?, tags?}.",
        "operationId": "freshdesk.tickets.update",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "tags": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "subject": {
                    "type": "string"
                  },
                  "group_id": {
                    "type": "string"
                  },
                  "priority": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "responder_id": {
                    "type": "string"
                  }
                },
                "description": "{subject?, description?, status?, priority?, type?, responder_id?, group_id?, tags?}"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/v2/contacts/{id}": {
      "get": {
        "summary": "Look up a single contact record by ID. Returns full details for the specified customer or requester.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "description": "Contact object"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "The unique identifier of the contact to fetch."
          }
        ],
        "description": "Look up a single contact record by ID. Returns full details for the specified customer or requester.",
        "operationId": "freshdesk.contacts.get"
      }
    },
    "/api/v2/search/tickets": {
      "get": {
        "summary": "Query tickets using a structured filter syntax such as \"(status:2 OR priority:3)\". Useful for locating tickets matching specific field criteria.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "description": "SearchTicketsResponse: {tickets: [Ticket], count: int}"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "query",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "A filter expression using Freshdesk query syntax, e.g. \"(status:2 OR priority:3)\"."
          }
        ],
        "description": "Query tickets using a structured filter syntax such as \"(status:2 OR priority:3)\". Useful for locating tickets matching specific field criteria.",
        "operationId": "freshdesk.tickets.search"
      }
    },
    "/api/v2/search/contacts": {
      "get": {
        "summary": "Search for contacts using a structured query or direct lookup by email or contact ID. Useful for finding a specific customer or requester.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "description": "SearchContactsResponse: {contacts: [Contact], count: int}"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "query",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "A filter expression using Freshdesk query syntax, e.g. \"(email:'user@example.com')\"."
          },
          {
            "in": "query",
            "name": "email",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Locate a contact by their exact email address."
          },
          {
            "in": "query",
            "name": "contact_id",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Locate a contact by their unique ID."
          }
        ],
        "description": "Search for contacts using a structured query or direct lookup by email or contact ID. Useful for finding a specific customer or requester.",
        "operationId": "freshdesk.contacts.search"
      }
    },
    "/api/v2/tickets/{ticket_id}/notes": {
      "post": {
        "summary": "Append a note to a ticket. The note can be internal (private) or visible to the requester (public).",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "note_id": {
                      "type": "string"
                    },
                    "ticket_id": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "description": "{ticket_id, note_id}"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "ticket_id",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "The identifier of the ticket to attach the note to."
          }
        ],
        "description": "Append a note to a ticket. The note can be internal (private) or visible to the requester (public). Request body: {body: string, private?: boolean}.",
        "operationId": "freshdesk.tickets.notes.create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "body": {
                    "type": "string"
                  },
                  "private": {
                    "type": "boolean"
                  }
                },
                "description": "{body: string, private?: boolean}"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/v2/tickets/{ticket_id}/conversations": {
      "get": {
        "summary": "Retrieve all notes and replies in the conversation thread of a ticket. Returns the full correspondence history for a support case.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "description": "ListNotesResponse: {notes: [Note], count: int}"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "ticket_id",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "The identifier of the ticket whose conversations to retrieve."
          }
        ],
        "description": "Retrieve all notes and replies in the conversation thread of a ticket. Returns the full correspondence history for a support case.",
        "operationId": "freshdesk.tickets.notes.list"
      }
    }
  },
  "openapi": "3.1.0",
  "servers": [
    {
      "url": "http://automationbench-api:8080/api/freshdesk"
    }
  ],
  "components": {
    "schemas": {
      "Note": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the note."
          },
          "body": {
            "type": "string",
            "description": "Text content of the note."
          },
          "private": {
            "type": "boolean",
            "description": "When true, the note is internal and not visible to the requester."
          },
          "created_at": {
            "type": "string",
            "description": "Date and time when the note was created."
          }
        }
      },
      "Ticket": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique numeric identifier for the ticket."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Labels or tags attached to the ticket."
          },
          "type": {
            "type": "string",
            "description": "Classification of the ticket (e.g., Question, Incident, Problem, Feature Request)."
          },
          "source": {
            "type": "integer",
            "description": "Inbound channel for the ticket: 1=Email, 2=Portal, 3=Phone, 4=Forum, 5=Twitter, 6=Facebook, 7=Chat, 8=Mobihelp, 9=Feedback Widget, 10=Outbound Email."
          },
          "status": {
            "enum": [
              2,
              3,
              4,
              5,
              6,
              7
            ],
            "type": "integer",
            "description": "Numeric status code: 2=Open, 3=Pending, 4=Resolved, 5=Closed, 6=Waiting on Customer, 7=Waiting on Third Party."
          },
          "subject": {
            "type": "string",
            "description": "Title or subject line of the support ticket."
          },
          "group_id": {
            "type": "string",
            "description": "Identifier of the team group assigned to the ticket."
          },
          "priority": {
            "enum": [
              1,
              2,
              3,
              4
            ],
            "type": "integer",
            "description": "Numeric priority level: 1=Low, 2=Medium, 3=High, 4=Urgent."
          },
          "created_at": {
            "type": "string",
            "description": "Date and time when the ticket was originally created."
          },
          "updated_at": {
            "type": "string",
            "description": "Date and time of the most recent update to the ticket."
          },
          "description": {
            "type": "string",
            "description": "Full body of the ticket, formatted as HTML."
          },
          "requester_id": {
            "type": "string",
            "description": "Identifier of the contact who submitted the ticket."
          },
          "responder_id": {
            "type": "string",
            "description": "Identifier of the agent assigned to handle the ticket."
          }
        }
      },
      "Company": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the company."
          },
          "name": {
            "type": "string",
            "description": "Legal or display name of the company."
          },
          "note": {
            "type": "string",
            "description": "Free-form notes attached to the company record."
          },
          "domains": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Web domains linked to this company."
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "description": "Brief overview or notes about the company."
          }
        }
      },
      "Contact": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the contact."
          },
          "name": {
            "type": "string",
            "description": "Full name of the contact."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Labels or tags associated with the contact."
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email address of the contact."
          },
          "phone": {
            "type": "string",
            "description": "Telephone number for the contact."
          },
          "mobile": {
            "type": "string",
            "description": "Mobile or cell phone number for the contact."
          },
          "job_title": {
            "type": "string",
            "description": "Professional title or role of the contact."
          },
          "company_id": {
            "type": "string",
            "description": "Identifier of the company this contact belongs to."
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "description": "Additional notes or context about the contact."
          }
        }
      }
    }
  }
}
