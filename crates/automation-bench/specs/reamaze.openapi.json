{
  "info": {
    "title": "Reamaze",
    "version": "v1",
    "description": "Simulated Reamaze API for deterministic AutomationBench workflow evaluation."
  },
  "paths": {
    "/contacts": {
      "get": {
        "summary": "Retrieve all Re:amaze contacts and customers.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer"
                    },
                    "contacts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "ContactObject": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "description": "{contacts: [ContactObject], count: int}"
          }
        },
        "description": "Retrieve all Re:amaze contacts and customers.",
        "operationId": "reamaze.contacts.list"
      },
      "post": {
        "summary": "Add a new Re:amaze contact or customer record.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "contact": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                }
              }
            },
            "description": "{contact: ContactObject, id: string}"
          }
        },
        "description": "Add a new Re:amaze contact or customer record. Request body: Body: {contact: {email (required, string), name (optional, string), phone (optional, string), notes (optional, string), external_id (optional, string — unique identifier in your app)}}.",
        "operationId": "reamaze.contacts.create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "contact"
                ],
                "properties": {
                  "contact": {
                    "type": "object",
                    "required": [
                      "email"
                    ],
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "email": {
                        "type": "string",
                        "format": "email"
                      },
                      "notes": {
                        "type": "string"
                      },
                      "phone": {
                        "type": "string"
                      },
                      "external_id": {
                        "type": "string"
                      }
                    }
                  }
                },
                "description": "Body: {contact: {email (required, string), name (optional, string), phone (optional, string), notes (optional, string), external_id (optional, string — unique identifier in your app)}}"
              }
            }
          },
          "required": true
        }
      }
    },
    "/conversations": {
      "get": {
        "summary": "Retrieve all Re:amaze conversations, tickets, and threads. Fetch the full list of support conversations.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "page_size": {
                      "type": "integer"
                    },
                    "page_count": {
                      "type": "integer"
                    },
                    "total_count": {
                      "type": "integer"
                    },
                    "conversations": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "ConversationObject": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "description": "{conversations: [ConversationObject], page_size: int, page_count: int, total_count: int}"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "filter",
            "schema": {
              "enum": [
                "archived",
                "open",
                "unassigned",
                "all"
              ],
              "type": "string"
            },
            "required": false,
            "description": "Narrow conversations by their current state."
          },
          {
            "in": "query",
            "name": "for",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Restrict results to a specific user's email address."
          },
          {
            "in": "query",
            "name": "sort",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Ordering applied to the returned results."
          },
          {
            "in": "query",
            "name": "tag",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Restrict results to conversations with a given tag."
          },
          {
            "in": "query",
            "name": "category",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Restrict results to a specific category slug."
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer"
            },
            "required": false,
            "description": "Which page of results to return."
          },
          {
            "in": "query",
            "name": "start_date",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Return only conversations created on or after this date."
          },
          {
            "in": "query",
            "name": "end_date",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Return only conversations created on or before this date."
          },
          {
            "in": "query",
            "name": "origin",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Restrict results to a particular conversation channel or origin."
          }
        ],
        "description": "Retrieve all Re:amaze conversations, tickets, and threads. Fetch the full list of support conversations.",
        "operationId": "reamaze.conversations.list"
      },
      "post": {
        "summary": "Open a new Re:amaze conversation or support ticket.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "conversation": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                }
              }
            },
            "description": "{conversation: ConversationObject, id: string}"
          }
        },
        "description": "Open a new Re:amaze conversation or support ticket. Request body: Body: {conversation: {subject (optional, string), category (required, string — channel slug), message: {body (required, string), recipients (optional, array of email strings), suppress_notifications (optional, boolean)}, user: {email (required, string), name (optional, string)}, tag_list (optional, array of strings), status (optional, integer — 0=Open, 1=Responded, 2=Done, 3=Spam, 4=Archived, 5=On Hold, 6=Auto-Done, 7=AI Agent Assigned, 8=AI Agent Done, 9=Spam AI), assignee (optional, string — assignee email), data (optional, object — custom field key-value pairs)}}.",
        "operationId": "reamaze.conversations.create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "conversation"
                ],
                "properties": {
                  "conversation": {
                    "type": "object",
                    "required": [
                      "category",
                      "message",
                      "user"
                    ],
                    "properties": {
                      "data": {
                        "type": "object",
                        "additionalProperties": true
                      },
                      "user": {
                        "type": "object",
                        "required": [
                          "email"
                        ],
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "email": {
                            "type": "string",
                            "format": "email"
                          }
                        }
                      },
                      "status": {
                        "type": "integer"
                      },
                      "message": {
                        "type": "object",
                        "required": [
                          "body"
                        ],
                        "properties": {
                          "body": {
                            "type": "string"
                          },
                          "recipients": {
                            "type": "string",
                            "format": "email"
                          },
                          "suppress_notifications": {
                            "type": "boolean"
                          }
                        }
                      },
                      "subject": {
                        "type": "string"
                      },
                      "assignee": {
                        "type": "string",
                        "format": "email"
                      },
                      "category": {
                        "type": "string"
                      },
                      "tag_list": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "description": "Body: {conversation: {subject (optional, string), category (required, string — channel slug), message: {body (required, string), recipients (optional, array of email strings), suppress_notifications (optional, boolean)}, user: {email (required, string), name (optional, string)}, tag_list (optional, array of strings), status (optional, integer — 0=Open, 1=Responded, 2=Done, 3=Spam, 4=Archived, 5=On Hold, 6=Auto-Done, 7=AI Agent Assigned, 8=AI Agent Done, 9=Spam AI), assignee (optional, string — assignee email), data (optional, object — custom field key-value pairs)}}"
              }
            }
          },
          "required": true
        }
      }
    },
    "/conversations/{conversation_id}": {
      "put": {
        "summary": "Modify an existing Re:amaze conversation. Adjust its status, category, tags, or assigned agent.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "conversation": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                }
              }
            },
            "description": "{conversation: ConversationObject, id: string}"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Identifier of the conversation to update."
          }
        ],
        "description": "Modify an existing Re:amaze conversation. Adjust its status, category, tags, or assigned agent. Request body: Body: {conversation: {status (optional, integer — 0=Open, 1=Responded, 2=Done, 3=Spam, 4=Archived, 5=On Hold, 6=Auto-Done, 7=AI Agent Assigned, 8=AI Agent Done, 9=Spam AI), hold_until (optional, ISO 8601 datetime — when status=5), assignee: {email (optional, string)}, tag_list (optional, array of strings), category (optional, string — email channel name), data (optional, object — custom field key-value pairs), brand (optional, string — brand URL for moving conversations)}}.",
        "operationId": "reamaze.conversations.update",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "conversation": {
                    "type": "object",
                    "properties": {
                      "data": {
                        "type": "object",
                        "additionalProperties": true
                      },
                      "brand": {
                        "type": "string"
                      },
                      "status": {
                        "type": "integer"
                      },
                      "assignee": {
                        "type": "object",
                        "properties": {
                          "email": {
                            "type": "string",
                            "format": "email"
                          }
                        }
                      },
                      "category": {
                        "type": "string",
                        "format": "email"
                      },
                      "tag_list": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "hold_until": {
                        "type": "string",
                        "format": "date-time"
                      }
                    }
                  }
                },
                "description": "Body: {conversation: {status (optional, integer — 0=Open, 1=Responded, 2=Done, 3=Spam, 4=Archived, 5=On Hold, 6=Auto-Done, 7=AI Agent Assigned, 8=AI Agent Done, 9=Spam AI), hold_until (optional, ISO 8601 datetime — when status=5), assignee: {email (optional, string)}, tag_list (optional, array of strings), category (optional, string — email channel name), data (optional, object — custom field key-value pairs), brand (optional, string — brand URL for moving conversations)}}"
              }
            }
          },
          "required": true
        }
      }
    },
    "/conversations/{conversation_id}/messages": {
      "post": {
        "summary": "Append a message or reply to an existing Re:amaze conversation.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "message_id": {
                      "type": "string"
                    },
                    "conversation_id": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "description": "{message: MessageObject, conversation_id: string, message_id: string}"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Identifier of the conversation to add a message to."
          }
        ],
        "description": "Append a message or reply to an existing Re:amaze conversation. Request body: Body: {message: {body (required, string — supports markdown), visibility (optional, integer — 0=Regular, 1=Internal Note), user (optional, object — {email, name} to specify sender), suppress_notifications (optional, boolean), suppress_autoresolve (optional, boolean), attachment (optional, string — file URL)}}.",
        "operationId": "reamaze.conversations.addMessage",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "message"
                ],
                "properties": {
                  "message": {
                    "type": "object",
                    "required": [
                      "body"
                    ],
                    "properties": {
                      "body": {
                        "type": "string"
                      },
                      "user": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "email": {
                            "type": "string",
                            "format": "email"
                          }
                        }
                      },
                      "attachment": {
                        "type": "string",
                        "format": "binary"
                      },
                      "visibility": {
                        "type": "integer"
                      },
                      "suppress_autoresolve": {
                        "type": "boolean"
                      },
                      "suppress_notifications": {
                        "type": "boolean"
                      }
                    }
                  }
                },
                "description": "Body: {message: {body (required, string — supports markdown), visibility (optional, integer — 0=Regular, 1=Internal Note), user (optional, object — {email, name} to specify sender), suppress_notifications (optional, boolean), suppress_autoresolve (optional, boolean), attachment (optional, string — file URL)}}"
              }
            }
          },
          "required": true
        }
      }
    }
  },
  "openapi": "3.1.0",
  "servers": [
    {
      "url": "http://automationbench-api:8080/api/reamaze"
    }
  ],
  "components": {
    "schemas": {}
  }
}
