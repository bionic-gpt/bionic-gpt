{
  "info": {
    "title": "Calendly",
    "version": "v2",
    "description": "Simulated Calendly API for deterministic AutomationBench workflow evaluation."
  },
  "paths": {
    "/event_types": {
      "get": {
        "summary": "List the available meeting types and scheduling page configurations for a user or organization.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "collection": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/EventType"
                      }
                    },
                    "pagination": {
                      "type": "object",
                      "properties": {
                        "count": {
                          "type": "string"
                        },
                        "next_page": {
                          "type": "string"
                        },
                        "next_page_token": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            },
            "description": "{collection: [EventType], pagination: {count, next_page, next_page_token}}"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "organization",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Return event types for the organization at this URI."
          },
          {
            "in": "query",
            "name": "user",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Return event types for the user at this URI."
          },
          {
            "in": "query",
            "name": "active",
            "schema": {
              "type": "boolean"
            },
            "required": false,
            "description": "When provided, filters to only active or only inactive event types."
          },
          {
            "in": "query",
            "name": "count",
            "schema": {
              "type": "integer"
            },
            "required": false,
            "description": "Number of records per page (1–100, default 20)."
          },
          {
            "in": "query",
            "name": "page_token",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Continuation token for the next page of results."
          },
          {
            "in": "query",
            "name": "sort",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Order results. Accepted values: 'name:asc' or 'name:desc'."
          }
        ],
        "description": "List the available meeting types and scheduling page configurations for a user or organization.",
        "operationId": "calendly.event_types.list"
      }
    },
    "/users/{user_id}": {
      "get": {
        "summary": "Fetch a Calendly user by UUID, or supply 'me' to get the authenticated user. Returns the user's profile, scheduling URL, and timezone.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "resource": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            },
            "description": "{resource: User}"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "user_id",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "UUID of the user, or 'me' for the currently authenticated user."
          }
        ],
        "description": "Fetch a Calendly user by UUID, or supply 'me' to get the authenticated user. Returns the user's profile, scheduling URL, and timezone.",
        "operationId": "calendly.users.get"
      }
    },
    "/invitee_no_shows": {
      "post": {
        "summary": "Flag an invitee as a no-show. Registers that the attendee did not appear for their scheduled meeting.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "resource": {
                      "$ref": "#/components/schemas/InviteeNoShow"
                    }
                  }
                }
              }
            },
            "description": "{resource: InviteeNoShow}"
          }
        },
        "description": "Flag an invitee as a no-show. Registers that the attendee did not appear for their scheduled meeting. Request body: Body: {invitee (required, string — full URI of the invitee, e.g. https://api.calendly.com/scheduled_events/{event_uuid}/invitees/{invitee_uuid})}.",
        "operationId": "calendly.invitee_no_shows.create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "invitee (required, string — full URI of the invitee, e.g. https": {
                    "type": "object",
                    "properties": {
                      "event_uuid}/invitees/{invitee_uuid": {
                        "type": "string"
                      }
                    }
                  }
                },
                "description": "Body: {invitee (required, string — full URI of the invitee, e.g. https://api.calendly.com/scheduled_events/{event_uuid}/invitees/{invitee_uuid})}"
              }
            }
          },
          "required": true
        }
      }
    },
    "/scheduled_events": {
      "get": {
        "summary": "Retrieve scheduled events (meetings, appointments, and bookings). Supports filtering by user, invitee email, date range, or status.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "collection": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Event"
                      }
                    },
                    "pagination": {
                      "type": "object",
                      "properties": {
                        "count": {
                          "type": "string"
                        },
                        "next_page": {
                          "type": "string"
                        },
                        "next_page_token": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            },
            "description": "{collection: [Event], pagination: {count, next_page, next_page_token}}"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "organization",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Limit results to events belonging to the organization at this URI."
          },
          {
            "in": "query",
            "name": "user",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Limit results to events for the user at this URI. Required when organization is not provided."
          },
          {
            "in": "query",
            "name": "invitee_email",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Limit results to events that include the specified invitee email."
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "enum": [
                "active",
                "canceled"
              ],
              "type": "string"
            },
            "required": false,
            "description": "Narrow results to events with this status."
          },
          {
            "in": "query",
            "name": "min_start_time",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "required": false,
            "description": "Return only events starting at or after this ISO 8601 UTC timestamp."
          },
          {
            "in": "query",
            "name": "max_start_time",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "required": false,
            "description": "Return only events starting before this ISO 8601 UTC timestamp."
          },
          {
            "in": "query",
            "name": "count",
            "schema": {
              "type": "integer"
            },
            "required": false,
            "description": "Number of records per page (1–100, default 20)."
          },
          {
            "in": "query",
            "name": "page_token",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Continuation token for the next page of results."
          },
          {
            "in": "query",
            "name": "sort",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Order results by start_time. Accepted values: 'start_time:asc' or 'start_time:desc'."
          },
          {
            "in": "query",
            "name": "group",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Limit results to events for the group at this URI."
          }
        ],
        "description": "Retrieve scheduled events (meetings, appointments, and bookings). Supports filtering by user, invitee email, date range, or status.",
        "operationId": "calendly.scheduled_events.list"
      }
    },
    "/scheduling_links": {
      "post": {
        "summary": "Schedule a Calendly meeting by generating a booking link for an event type. When invitee_email is provided, this also creates the scheduled event and invitee record immediately (simulating a completed booking). Use this endpoint to book meetings, schedule appointments, or create events with specific invitees.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "resource": {
                      "type": "object",
                      "properties": {
                        "owner": {
                          "type": "string"
                        },
                        "owner_type": {
                          "type": "string"
                        },
                        "booking_url": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            },
            "description": "{resource: {booking_url (string), owner (string), owner_type (string)}}"
          }
        },
        "description": "Schedule a Calendly meeting by generating a booking link for an event type. When invitee_email is provided, this also creates the scheduled event and invitee record immediately (simulating a completed booking). Use this endpoint to book meetings, schedule appointments, or create events with specific invitees. Request body: Body: {max_event_count (required, integer — number of allowed bookings, typically 1), owner (required, string — event type URI or ID), owner_type (required, string — 'EventType'), invitee_email (optional, string — primary invitee email used to auto-create a scheduled event and invitee record), event_guests (optional, array of guest email strings or objects with an email field — additional attendees on that same event), name (optional, string — custom event name override, e.g. 'Vendor Site Visit - Acme Corp'), start_time (optional, string — ISO 8601 datetime for the event start), end_time (optional, string — ISO 8601 datetime for the event end)}.",
        "operationId": "calendly.scheduling_links.create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "max_event_count",
                  "owner",
                  "owner_type"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "owner": {
                    "type": "string"
                  },
                  "end_time": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "owner_type": {
                    "$ref": "#/components/schemas/EventType"
                  },
                  "start_time": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "event_guests": {
                    "type": "string",
                    "format": "email"
                  },
                  "invitee_email": {
                    "type": "string",
                    "format": "email"
                  },
                  "max_event_count": {
                    "type": "integer"
                  }
                },
                "description": "Body: {max_event_count (required, integer — number of allowed bookings, typically 1), owner (required, string — event type URI or ID), owner_type (required, string — 'EventType'), invitee_email (optional, string — primary invitee email used to auto-create a scheduled event and invitee record), event_guests (optional, array of guest email strings or objects with an email field — additional attendees on that same event), name (optional, string — custom event name override, e.g. 'Vendor Site Visit - Acme Corp'), start_time (optional, string — ISO 8601 datetime for the event start), end_time (optional, string — ISO 8601 datetime for the event end)}"
              }
            }
          },
          "required": true
        }
      }
    },
    "/one_off_event_types": {
      "post": {
        "summary": "Generate a one-time meeting link. Creates a unique scheduling URL for a standalone meeting that is not tied to a recurring event type.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "resource": {
                      "$ref": "#/components/schemas/Event"
                    },
                    "booking_url": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "description": "{resource: Event, booking_url: string}"
          }
        },
        "description": "Generate a one-time meeting link. Creates a unique scheduling URL for a standalone meeting that is not tied to a recurring event type. Request body: {name: string, host: string, duration: integer, start_date: string, end_date: string, co_hosts: [string], timezone: string, location_kind: string, location_location: string, location_additional_info: string}.",
        "operationId": "calendly.one_off_event_types.create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "host": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "co_hosts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "string": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "duration": {
                    "type": "integer"
                  },
                  "end_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "timezone": {
                    "type": "string"
                  },
                  "start_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "location_kind": {
                    "type": "string"
                  },
                  "location_location": {
                    "type": "string"
                  },
                  "location_additional_info": {
                    "type": "string"
                  }
                },
                "description": "{name: string, host: string, duration: integer, start_date: string, end_date: string, co_hosts: [string], timezone: string, location_kind: string, location_location: string, location_additional_info: string}"
              }
            }
          },
          "required": true
        }
      }
    },
    "/scheduled_events/{uuid}": {
      "get": {
        "summary": "Fetch complete details for a single scheduled event by its UUID, including time, location, host, and invitee counts.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "resource": {
                      "$ref": "#/components/schemas/Event"
                    }
                  }
                }
              }
            },
            "description": "{resource: Event}"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "uuid",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "UUID of the scheduled event to retrieve."
          }
        ],
        "description": "Fetch complete details for a single scheduled event by its UUID, including time, location, host, and invitee counts.",
        "operationId": "calendly.scheduled_events.get"
      }
    },
    "/scheduled_events/{uuid}/invitees": {
      "get": {
        "summary": "List all invitees on a scheduled event, including their booking status, contact details, and question responses.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "collection": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Invitee"
                      }
                    },
                    "pagination": {
                      "type": "object",
                      "properties": {
                        "count": {
                          "type": "string"
                        },
                        "next_page": {
                          "type": "string"
                        },
                        "next_page_token": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            },
            "description": "{collection: [Invitee], pagination: {count, next_page, next_page_token}}"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "uuid",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "UUID of the scheduled event whose invitees to list."
          },
          {
            "in": "query",
            "name": "count",
            "schema": {
              "type": "integer"
            },
            "required": false,
            "description": "Number of records per page (1–100, default 20)."
          },
          {
            "in": "query",
            "name": "email",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Narrow results to invitees matching this exact email address."
          },
          {
            "in": "query",
            "name": "page_token",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Continuation token for the next page of results."
          },
          {
            "in": "query",
            "name": "sort",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Order results. Accepted values: 'created_at:asc' or 'created_at:desc'."
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "enum": [
                "active",
                "canceled"
              ],
              "type": "string"
            },
            "required": false,
            "description": "Narrow results to invitees with this status."
          }
        ],
        "description": "List all invitees on a scheduled event, including their booking status, contact details, and question responses.",
        "operationId": "calendly.scheduled_events.invitees.list"
      }
    },
    "/scheduled_events/{uuid}/cancellation": {
      "post": {
        "summary": "Cancel a scheduled event. Generates a cancellation record and sends notifications to all invitees.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "resource": {
                      "$ref": "#/components/schemas/Cancellation"
                    }
                  }
                }
              }
            },
            "description": "{resource: Cancellation}"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "uuid",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "UUID of the scheduled event to cancel."
          }
        ],
        "description": "Cancel a scheduled event. Generates a cancellation record and sends notifications to all invitees. Request body: {reason: string} - Optional cancellation reason..",
        "operationId": "calendly.scheduled_events.cancel",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string"
                  }
                },
                "description": "{reason: string} - Optional cancellation reason."
              }
            }
          },
          "required": true
        }
      }
    }
  },
  "openapi": "3.1.0",
  "servers": [
    {
      "url": "http://automationbench-api:8080/api/calendly"
    }
  ],
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "uri": {
            "type": "string",
            "description": "API resource path for this user."
          },
          "name": {
            "type": "string",
            "description": "Full name of the user."
          },
          "slug": {
            "type": "string",
            "description": "URL segment used in the user's scheduling page address."
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email address of the user."
          },
          "timezone": {
            "type": "string",
            "description": "IANA timezone identifier for the user."
          },
          "avatar_url": {
            "type": "string",
            "description": "URL pointing to the user's profile picture."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "scheduling_url": {
            "type": "string",
            "description": "URL of the user's Calendly booking page."
          },
          "current_organization": {
            "type": "string",
            "description": "URI of the organization this user currently belongs to."
          }
        }
      },
      "Event": {
        "type": "object",
        "properties": {
          "uri": {
            "type": "string",
            "description": "API resource path for this scheduled event."
          },
          "name": {
            "type": "string",
            "description": "Display name of the event."
          },
          "status": {
            "enum": [
              "active",
              "canceled"
            ],
            "type": "string",
            "description": "Indicates whether the event is currently active or has been canceled."
          },
          "end_time": {
            "type": "string",
            "format": "date-time",
            "description": "When the event is scheduled to conclude, in UTC."
          },
          "location": {
            "$ref": "#/components/schemas/Location"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "event_type": {
            "type": "string",
            "description": "URI referencing the event type this event was booked from."
          },
          "start_time": {
            "type": "string",
            "format": "date-time",
            "description": "When the event is scheduled to begin, in UTC."
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "event_guests": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string",
                  "format": "email"
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "updated_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          "invitees_counter": {
            "type": "object",
            "properties": {
              "limit": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              },
              "active": {
                "type": "integer"
              }
            }
          },
          "event_memberships": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "user": {
                  "type": "string"
                }
              }
            },
            "description": "Host memberships for this event, each containing a user URI."
          }
        }
      },
      "Invitee": {
        "type": "object",
        "properties": {
          "uri": {
            "type": "string",
            "description": "API resource path for this invitee record."
          },
          "name": {
            "type": "string",
            "description": "Full name of the invitee."
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email address of the invitee."
          },
          "event": {
            "type": "string",
            "description": "URI of the event this invitee is associated with."
          },
          "status": {
            "enum": [
              "active",
              "canceled"
            ],
            "type": "string",
            "description": "Whether the invitee's booking is active or has been canceled."
          },
          "no_show": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "uri": {
                "type": "string"
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "description": "No-show record for this invitee if they missed the event, or null if they attended."
          },
          "timezone": {
            "type": "string",
            "description": "IANA timezone identifier for the invitee."
          },
          "tracking": {
            "type": "object",
            "properties": {
              "utm_term": {
                "type": "string"
              },
              "utm_medium": {
                "type": "string"
              },
              "utm_source": {
                "type": "string"
              },
              "utm_content": {
                "type": "string"
              },
              "utm_campaign": {
                "type": "string"
              },
              "salesforce_uuid": {
                "type": "string"
              }
            }
          },
          "last_name": {
            "type": "string"
          },
          "cancel_url": {
            "type": "string",
            "description": "URL the invitee can use to cancel their booking."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "first_name": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
