{
  "info": {
    "title": "Google Sheets",
    "x-logo": {
      "url": "https://cdn.simpleicons.org/googlesheets"
    },
    "version": "v4",
    "description": "Simulated Google Sheets API for deterministic spreadsheet workflow evaluations."
  },
  "paths": {
    "/v4/spreadsheets": {
      "post": {
        "summary": "Generate a new spreadsheet. Creates a fresh Google Sheets document with optional initial sheet configuration.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "description": "Spreadsheet: {spreadsheetId, properties: {title}, sheets: [{properties: {sheetId, title, index, sheetType}}], spreadsheetUrl}"
          }
        },
        "description": "Generate a new spreadsheet. Creates a fresh Google Sheets document with optional initial sheet configuration. Request body: {properties: {title: string (required)}, sheets?: [{properties: {title: string}}]}.",
        "operationId": "sheets.spreadsheets.create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "properties"
                ],
                "properties": {
                  "sheets": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "properties": {
                          "type": "object",
                          "properties": {
                            "title": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  },
                  "properties": {
                    "type": "object",
                    "required": [
                      "title"
                    ],
                    "properties": {
                      "title": {
                        "type": "string"
                      }
                    }
                  }
                },
                "description": "{properties: {title: string (required)}, sheets?: [{properties: {title: string}}]}"
              }
            }
          },
          "required": true
        }
      }
    },
    "/v4/spreadsheets/{spreadsheetId}": {
      "get": {
        "summary": "Retrieve a spreadsheet by its ID. Returns document metadata, sheet listings, and optionally the grid cell data.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "description": "Spreadsheet: {spreadsheetId, properties: {title}, sheets: [{properties: {sheetId, title, index, sheetType}, data}], spreadsheetUrl}"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "spreadsheetId",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Identifier of the spreadsheet to retrieve."
          },
          {
            "in": "query",
            "name": "includeGridData",
            "schema": {
              "type": "boolean"
            },
            "required": false,
            "description": "Whether to include cell-level data in the response (default false)."
          },
          {
            "in": "query",
            "name": "ranges",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "required": false,
            "description": "Specific ranges to retrieve from the spreadsheet in A1 notation (e.g., 'Sheet1!A1:B5')."
          }
        ],
        "description": "Retrieve a spreadsheet by its ID. Returns document metadata, sheet listings, and optionally the grid cell data.",
        "operationId": "sheets.spreadsheets.get"
      }
    },
    "/v4/spreadsheets/{spreadsheetId}:batchUpdate": {
      "post": {
        "summary": "Execute one or more structural changes on a spreadsheet in one request. Supports adding sheets (AddSheetRequest), deleting sheets (DeleteSheetRequest), renaming sheets (UpdateSheetPropertiesRequest), and other layout operations.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "replies": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "addSheet": {
                            "type": "object",
                            "properties": {
                              "properties": {
                                "type": "object",
                                "properties": {
                                  "index": {
                                    "type": "string"
                                  },
                                  "title": {
                                    "type": "string"
                                  },
                                  "sheetId": {
                                    "type": "string"
                                  },
                                  "sheetType": {
                                    "type": "string"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "spreadsheetId": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "description": "{spreadsheetId, replies: [{addSheet?: {properties: {sheetId, title, index, sheetType}}}]}"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "spreadsheetId",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Identifier of the target spreadsheet."
          }
        ],
        "description": "Execute one or more structural changes on a spreadsheet in one request. Supports adding sheets (AddSheetRequest), deleting sheets (DeleteSheetRequest), renaming sheets (UpdateSheetPropertiesRequest), and other layout operations. Request body: {requests: [{addSheet?: {properties: {title: string, index?: int}}, deleteSheet?: {sheetId: int}, updateSheetProperties?: {properties: {sheetId: int, title?: string, index?: int}, fields: string (e.g. 'title')}}]}.",
        "operationId": "sheets.spreadsheets.batchUpdate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "requests": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "addSheet": {
                          "type": "object",
                          "properties": {
                            "properties": {
                              "type": "object",
                              "properties": {
                                "index": {
                                  "type": "integer"
                                },
                                "title": {
                                  "type": "string"
                                }
                              }
                            }
                          }
                        },
                        "deleteSheet": {
                          "type": "object",
                          "properties": {
                            "sheetId": {
                              "type": "integer"
                            }
                          }
                        },
                        "updateSheetProperties": {
                          "type": "object",
                          "properties": {
                            "fields": {
                              "type": "string"
                            },
                            "properties": {
                              "type": "object",
                              "properties": {
                                "index": {
                                  "type": "integer"
                                },
                                "title": {
                                  "type": "string"
                                },
                                "sheetId": {
                                  "type": "integer"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "description": "{requests: [{addSheet?: {properties: {title: string, index?: int}}, deleteSheet?: {sheetId: int}, updateSheetProperties?: {properties: {sheetId: int, title?: string, index?: int}, fields: string (e.g. 'title')}}]}"
              }
            }
          },
          "required": true
        }
      }
    },
    "/v4/spreadsheets/{spreadsheetId}/values/{range}": {
      "get": {
        "summary": "Read cell contents from a specific range. Retrieves data from a range specified in A1 notation (e.g., 'Sheet1!A1:Z100').",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "description": "ValueRange: {range, majorDimension, values: [[cell, ...], ...]}"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "spreadsheetId",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Identifier of the target spreadsheet."
          },
          {
            "in": "path",
            "name": "range",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "The cell range to read in A1 notation (e.g., 'Sheet1!A1:Z100')."
          },
          {
            "in": "query",
            "name": "majorDimension",
            "schema": {
              "enum": [
                "ROWS",
                "COLUMNS"
              ],
              "type": "string"
            },
            "required": false,
            "description": "Primary axis of the returned values array (default ROWS)."
          },
          {
            "in": "query",
            "name": "valueRenderOption",
            "schema": {
              "enum": [
                "FORMATTED_VALUE",
                "UNFORMATTED_VALUE",
                "FORMULA"
              ],
              "type": "string"
            },
            "required": false,
            "description": "Controls how cell values are rendered in the response (default FORMATTED_VALUE)."
          },
          {
            "in": "query",
            "name": "dateTimeRenderOption",
            "schema": {
              "enum": [
                "SERIAL_NUMBER",
                "FORMATTED_STRING"
              ],
              "type": "string"
            },
            "required": false,
            "description": "Controls how date and time values appear (default SERIAL_NUMBER)."
          }
        ],
        "description": "Read cell contents from a specific range. Retrieves data from a range specified in A1 notation (e.g., 'Sheet1!A1:Z100').",
        "operationId": "sheets.spreadsheets.values.get"
      },
      "put": {
        "summary": "Replace the contents of a given range in a spreadsheet. Overwrites whatever cells currently exist in the target range.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "updatedData": {
                      "$ref": "#/components/schemas/ValueRange"
                    },
                    "updatedRows": {
                      "type": "string"
                    },
                    "updatedCells": {
                      "type": "string"
                    },
                    "updatedRange": {
                      "type": "string"
                    },
                    "spreadsheetId": {
                      "type": "string"
                    },
                    "updatedColumns": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "description": "{spreadsheetId, updatedRange, updatedRows, updatedColumns, updatedCells, updatedData: ValueRange}"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "spreadsheetId",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Identifier of the target spreadsheet."
          },
          {
            "in": "path",
            "name": "range",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "A1-notation range to overwrite (e.g., 'Sheet1!A1:B5')."
          },
          {
            "in": "query",
            "name": "valueInputOption",
            "schema": {
              "enum": [
                "RAW",
                "USER_ENTERED"
              ],
              "type": "string"
            },
            "required": true,
            "description": "How the input should be interpreted (required)."
          }
        ],
        "description": "Replace the contents of a given range in a spreadsheet. Overwrites whatever cells currently exist in the target range. Request body: {range: string, majorDimension?: string, values: [[cell, ...], ...]}.",
        "operationId": "sheets.spreadsheets.values.update",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "range": {
                    "type": "string"
                  },
                  "values": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "...": {
                          "type": "string"
                        },
                        "[cell, ...]": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "majorDimension": {
                    "type": "string"
                  }
                },
                "description": "{range: string, majorDimension?: string, values: [[cell, ...], ...]}"
              }
            }
          },
          "required": true
        }
      }
    },
    "/v4/spreadsheets/{spreadsheetId}/values:batchGet": {
      "get": {
        "summary": "Retrieve multiple cell ranges from a spreadsheet in one request. Specify each range as a repeated 'ranges' query parameter in A1 notation.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "valueRanges": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "range": {
                            "type": "string"
                          },
                          "values": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "...": {
                                  "type": "string"
                                },
                                "[cell, ...]": {
                                  "type": "string"
                                }
                              }
                            }
                          },
                          "majorDimension": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "spreadsheetId": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "description": "{spreadsheetId, valueRanges: [{range, majorDimension, values: [[cell, ...], ...]}]}"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "spreadsheetId",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Identifier of the target spreadsheet."
          },
          {
            "in": "query",
            "name": "ranges",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "required": false,
            "description": "Cell ranges to read in A1 notation (repeated query parameter, e.g., ranges=Sheet1!A1:B5&ranges=Sheet2!A1:C10)."
          },
          {
            "in": "query",
            "name": "majorDimension",
            "schema": {
              "enum": [
                "ROWS",
                "COLUMNS"
              ],
              "type": "string"
            },
            "required": false,
            "description": "Primary axis of the returned values arrays."
          },
          {
            "in": "query",
            "name": "valueRenderOption",
            "schema": {
              "enum": [
                "FORMATTED_VALUE",
                "UNFORMATTED_VALUE",
                "FORMULA"
              ],
              "type": "string"
            },
            "required": false
          }
        ],
        "description": "Retrieve multiple cell ranges from a spreadsheet in one request. Specify each range as a repeated 'ranges' query parameter in A1 notation.",
        "operationId": "sheets.spreadsheets.values.batchGet"
      }
    },
    "/v4/spreadsheets/{spreadsheetId}/values/{range}:clear": {
      "post": {
        "summary": "Erase the contents of a spreadsheet range. Deletes cell values while keeping the cells and their formatting in place.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "clearedRange": {
                      "type": "string"
                    },
                    "spreadsheetId": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "description": "{spreadsheetId, clearedRange}"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "spreadsheetId",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Identifier of the target spreadsheet."
          },
          {
            "in": "path",
            "name": "range",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "A1-notation range to clear (e.g., 'Sheet1!A1:B5')."
          }
        ],
        "description": "Erase the contents of a spreadsheet range. Deletes cell values while keeping the cells and their formatting in place. Request body: {}.",
        "operationId": "sheets.spreadsheets.values.clear",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {},
                "description": "{}"
              }
            }
          },
          "required": true
        }
      }
    },
    "/v4/spreadsheets/{spreadsheetId}/values/{range}:append": {
      "post": {
        "summary": "Insert new rows of data into a spreadsheet following the last occupied row in the given range.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "updates": {
                      "type": "object",
                      "properties": {
                        "updatedRows": {
                          "type": "string"
                        },
                        "updatedCells": {
                          "type": "string"
                        },
                        "updatedRange": {
                          "type": "string"
                        },
                        "spreadsheetId": {
                          "type": "string"
                        },
                        "updatedColumns": {
                          "type": "string"
                        }
                      }
                    },
                    "tableRange": {
                      "type": "string"
                    },
                    "spreadsheetId": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "description": "{spreadsheetId, tableRange, updates: {spreadsheetId, updatedRange, updatedRows, updatedColumns, updatedCells}}"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "spreadsheetId",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Identifier of the target spreadsheet."
          },
          {
            "in": "path",
            "name": "range",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "A1-notation range indicating where to append data (e.g., 'Sheet1!A1:E1')."
          },
          {
            "in": "query",
            "name": "valueInputOption",
            "schema": {
              "enum": [
                "RAW",
                "USER_ENTERED"
              ],
              "type": "string"
            },
            "required": true,
            "description": "How the input should be interpreted (required). USER_ENTERED parses formulas and values; RAW inserts text as-is."
          },
          {
            "in": "query",
            "name": "insertDataOption",
            "schema": {
              "enum": [
                "OVERWRITE",
                "INSERT_ROWS"
              ],
              "type": "string"
            },
            "required": false,
            "description": "Determines whether existing rows are overwritten or new rows are inserted (default OVERWRITE)."
          }
        ],
        "description": "Insert new rows of data into a spreadsheet following the last occupied row in the given range. Request body: {range: string, majorDimension?: string, values: [[cell, ...], ...]}.",
        "operationId": "sheets.spreadsheets.values.append",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "range": {
                    "type": "string"
                  },
                  "values": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "...": {
                          "type": "string"
                        },
                        "[cell, ...]": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "majorDimension": {
                    "type": "string"
                  }
                },
                "description": "{range: string, majorDimension?: string, values: [[cell, ...], ...]}"
              }
            }
          },
          "required": true
        }
      }
    },
    "/v4/spreadsheets/{spreadsheetId}/sheets/{sheetId}:copyTo": {
      "post": {
        "summary": "Duplicate a sheet tab into a different spreadsheet.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "index": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "sheetId": {
                      "type": "string"
                    },
                    "sheetType": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "description": "{sheetId, title, index, sheetType}"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "spreadsheetId",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Identifier of the source spreadsheet."
          },
          {
            "in": "path",
            "name": "sheetId",
            "schema": {
              "type": "integer"
            },
            "required": true,
            "description": "Numeric ID of the sheet to duplicate."
          }
        ],
        "description": "Duplicate a sheet tab into a different spreadsheet. Request body: {destinationSpreadsheetId: string (required, target spreadsheet ID)}.",
        "operationId": "sheets.spreadsheets.sheets.copyTo",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "destinationSpreadsheetId"
                ],
                "properties": {
                  "destinationSpreadsheetId": {
                    "type": "string"
                  }
                },
                "description": "{destinationSpreadsheetId: string (required, target spreadsheet ID)}"
              }
            }
          },
          "required": true
        }
      }
    }
  },
  "openapi": "3.1.0",
  "servers": [
    {
      "url": "http://automationbench-api:8080/api/google_sheets"
    }
  ],
  "components": {
    "schemas": {
      "Sheet": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Cell data for the grid (only present when includeGridData is true)."
          },
          "properties": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "description": "Zero-based position of the sheet among all tabs."
              },
              "title": {
                "type": "string",
                "description": "Label shown on the sheet tab."
              },
              "sheetId": {
                "type": "integer",
                "description": "Numeric ID that uniquely identifies this sheet."
              },
              "sheetType": {
                "enum": [
                  "GRID",
                  "OBJECT",
                  "DATA_SOURCE"
                ],
                "type": "string",
                "description": "The category of this sheet."
              }
            },
            "description": "Metadata and configuration for this sheet."
          }
        }
      },
      "ValueRange": {
        "type": "object",
        "properties": {
          "range": {
            "type": "string",
            "description": "The cell range expressed in A1 notation (e.g., Sheet1!A1:Z100)."
          },
          "values": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "The cell contents arranged as a two-dimensional array."
          },
          "majorDimension": {
            "enum": [
              "ROWS",
              "COLUMNS"
            ],
            "type": "string",
            "description": "The primary axis along which the values array is organized."
          }
        }
      },
      "Spreadsheet": {
        "type": "object",
        "properties": {
          "sheets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Sheet"
            },
            "description": "All worksheet tabs contained within this spreadsheet."
          },
          "properties": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "description": "The display title of the spreadsheet."
              },
              "locale": {
                "type": "string"
              },
              "timeZone": {
                "type": "string"
              },
              "autoRecalc": {
                "type": "string"
              },
              "defaultFormat": {
                "type": "object"
              }
            },
            "description": "Top-level settings that apply to the entire spreadsheet."
          },
          "spreadsheetId": {
            "type": "string",
            "description": "The globally unique identifier for this spreadsheet."
          },
          "spreadsheetUrl": {
            "type": "string",
            "description": "Web address for opening this spreadsheet."
          }
        }
      }
    }
  }
}
