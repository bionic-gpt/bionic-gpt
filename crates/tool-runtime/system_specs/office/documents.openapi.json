{
  "openapi": "3.1.0",
  "info": {
    "title": "Bionic Documents Office API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://office-tools:8080"
    }
  ],
  "paths": {
    "/documents/create_document": {
      "post": {
        "operationId": "create_document",
        "summary": "Create document",
        "description": "Create a new `.docx` file with structured content blocks and optional metadata.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "directory": {
                    "description": "Directory path starting with '/' where document will be created (e.g., '/', '/reports')",
                    "type": "string"
                  },
                  "file_name": {
                    "description": "File name ending with .docx (e.g., 'report.docx'); must not contain '/' characters",
                    "type": "string"
                  },
                  "content": {
                    "description": "List of content blocks to populate document; each block must have 'type' field: 'paragraph', 'heading', 'bullet_list', 'numbered_list', 'table', 'page_break', or 'section_break'",
                    "items": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/ParagraphBlock"
                        },
                        {
                          "$ref": "#/components/schemas/HeadingBlock"
                        },
                        {
                          "$ref": "#/components/schemas/BulletListBlock"
                        },
                        {
                          "$ref": "#/components/schemas/NumberedListBlock"
                        },
                        {
                          "$ref": "#/components/schemas/TableBlock"
                        },
                        {
                          "$ref": "#/components/schemas/PageBreakBlock"
                        },
                        {
                          "$ref": "#/components/schemas/SectionBreakBlock"
                        }
                      ]
                    },
                    "type": "array"
                  },
                  "metadata": {
                    "description": "(Optional) Optional document properties: title, subject, author, comments (shown in file properties)",
                    "nullable": true,
                    "$ref": "#/components/schemas/DocumentMetadata"
                  }
                },
                "required": [
                  "directory",
                  "file_name",
                  "content"
                ],
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "422": {
            "description": "Invalid operation input"
          }
        }
      }
    },
    "/documents/delete_document": {
      "post": {
        "operationId": "delete_document",
        "summary": "Delete document",
        "description": "Delete a .docx document from the filesystem.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file_path": {
                    "type": "string",
                    "format": "binary",
                    "description": "Office file upload"
                  }
                },
                "required": [
                  "file_path"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "422": {
            "description": "Invalid operation input"
          }
        }
      }
    },
    "/documents/get_document_overview": {
      "post": {
        "operationId": "get_document_overview",
        "summary": "Get document overview",
        "description": "Get document structure overview: heading hierarchy, paragraph count, and pagination info.\n\nUse this BEFORE read_document_content to see total_pages for pagination.\nReturns heading annotations (e.g., 'body.p.5') useful for navigating to specific sections.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file_path": {
                    "type": "string",
                    "format": "binary",
                    "description": "Office file upload"
                  }
                },
                "required": [
                  "file_path"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "422": {
            "description": "Invalid operation input"
          }
        }
      }
    },
    "/documents/read_document_content": {
      "post": {
        "operationId": "read_document_content",
        "summary": "Read document content",
        "description": "Read a `.docx` file and return structured content with stable edit identifiers.\n\nReturns paragraphs and tables with IDs like 'body.p.0', 'body.tbl.0.r.0.c.0' for targeted editing.\nReading is always paginated and pages are sized by content, so any document can be\nread whatever its length. A short document is a single page. The response reports\ntotal_pages; read a longer document by asking for each page_index in turn.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file_path": {
                    "type": "string",
                    "format": "binary",
                    "description": "Office file upload"
                  },
                  "page_index": {
                    "description": "(Optional) 0-based page to read. Reading is always paginated: a page holds as many paragraphs as fit in one response, so a long document simply has more pages. Omit to read the first page. The response metadata reports 'total_pages'; read the rest by asking for each page_index in turn (0 to total_pages-1).",
                    "nullable": true,
                    "type": "integer"
                  }
                },
                "required": [
                  "file_path"
                ],
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "422": {
            "description": "Invalid operation input"
          }
        }
      }
    },
    "/documents/read_image": {
      "post": {
        "operationId": "read_image",
        "summary": "Read image",
        "description": "Read an image from document using file path and annotation key.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file_path": {
                    "type": "string",
                    "format": "binary",
                    "description": "Office file upload"
                  },
                  "annotation": {
                    "description": "Annotation key from ImageRun in read_document_content output (e.g., 'body_p_0_r0'); the '@' prefix is optional",
                    "type": "string"
                  }
                },
                "required": [
                  "file_path",
                  "annotation"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "422": {
            "description": "Invalid operation input"
          }
        }
      }
    },
    "/documents/add_content_text": {
      "post": {
        "operationId": "add_content_text",
        "summary": "Add content text",
        "description": "Add text at a location (paragraph or after an identifier). Use to append content.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file_path": {
                    "type": "string",
                    "format": "binary",
                    "description": "Office file upload"
                  },
                  "identifier": {
                    "description": "Stable identifier from read_document_content specifying where to add text (e.g., 'body.p.0' for first paragraph, 'body.p.0.r.0' for first run)",
                    "type": "string"
                  },
                  "text": {
                    "description": "The text content to insert at the specified location",
                    "type": "string"
                  },
                  "position": {
                    "description": "Where to insert text relative to identifier: 'start'/'before' (prepend) or 'end'/'after' (append). Default: 'end'",
                    "type": "string"
                  }
                },
                "required": [
                  "file_path",
                  "identifier",
                  "text"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "422": {
            "description": "Invalid operation input"
          }
        }
      }
    },
    "/documents/edit_content_text": {
      "post": {
        "operationId": "edit_content_text",
        "summary": "Edit content text",
        "description": "Replace text content at a specific identifier in a .docx document.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file_path": {
                    "type": "string",
                    "format": "binary",
                    "description": "Office file upload"
                  },
                  "identifier": {
                    "description": "Stable identifier from read_document_content specifying the element to edit (e.g., 'body.p.0' for paragraph, 'body.p.0.r.0' for run)",
                    "type": "string"
                  },
                  "new_text": {
                    "description": "The replacement text that will completely replace the existing content at the identifier",
                    "type": "string"
                  }
                },
                "required": [
                  "file_path",
                  "identifier",
                  "new_text"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "422": {
            "description": "Invalid operation input"
          }
        }
      }
    },
    "/documents/delete_content_text": {
      "post": {
        "operationId": "delete_content_text",
        "summary": "Delete content text",
        "description": "Delete content at a specific identifier. Use to remove a paragraph or block.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file_path": {
                    "type": "string",
                    "format": "binary",
                    "description": "Office file upload"
                  },
                  "identifier": {
                    "description": "Stable identifier from read_document_content specifying element to delete (e.g., 'body.p.0')",
                    "type": "string"
                  },
                  "scope": {
                    "description": "What to delete: 'content' (clear text but keep element) or 'element' (remove entire element from document). Default: 'content'. Note: 'element' scope is not supported for cell identifiers.",
                    "type": "string"
                  },
                  "collapse_whitespace": {
                    "description": "For cell targets: if true and scope='content', removes all but first paragraph in cell. Default: false",
                    "type": "boolean"
                  }
                },
                "required": [
                  "file_path",
                  "identifier"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "422": {
            "description": "Invalid operation input"
          }
        }
      }
    },
    "/documents/add_image": {
      "post": {
        "operationId": "add_image",
        "summary": "Add image",
        "description": "Insert an image file into a document paragraph/run at a requested position.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file_path": {
                    "type": "string",
                    "format": "binary",
                    "description": "Office file upload"
                  },
                  "image_path": {
                    "type": "string",
                    "format": "binary",
                    "description": "Office file upload"
                  },
                  "identifier": {
                    "description": "Stable identifier from read_document_content specifying where to insert image (e.g., 'body.p.0')",
                    "type": "string"
                  },
                  "position": {
                    "description": "(Optional) Where to insert image in the target paragraph: 'start' or 'end'. Default: 'end'",
                    "nullable": true,
                    "type": "string"
                  },
                  "width": {
                    "description": "(Optional) Image width in inches (e.g., 3.5); if only width specified, height scales proportionally",
                    "nullable": true,
                    "type": "number"
                  },
                  "height": {
                    "description": "(Optional) Image height in inches (e.g., 2.0); if only height specified, width scales proportionally",
                    "nullable": true,
                    "type": "number"
                  }
                },
                "required": [
                  "file_path",
                  "image_path",
                  "identifier"
                ],
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "422": {
            "description": "Invalid operation input"
          }
        }
      }
    },
    "/documents/modify_image": {
      "post": {
        "operationId": "modify_image",
        "summary": "Modify image",
        "description": "Modify an embedded document image by index using rotate/flip/brightness/contrast operations.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file_path": {
                    "type": "string",
                    "format": "binary",
                    "description": "Office file upload"
                  },
                  "image_index": {
                    "description": "0-based index of the image to modify; use read_document_content to find image positions",
                    "type": "integer"
                  },
                  "operation": {
                    "description": "Operation to perform: 'rotate', 'flip', 'brightness', or 'contrast'",
                    "type": "string"
                  },
                  "rotation": {
                    "description": "(Optional) For 'rotate' operation: degrees to rotate clockwise (0-360)",
                    "nullable": true,
                    "type": "integer"
                  },
                  "flip": {
                    "description": "(Optional) For 'flip' operation: direction as 'horizontal' or 'vertical'",
                    "nullable": true,
                    "type": "string"
                  },
                  "brightness": {
                    "description": "(Optional) For 'brightness' operation: multiplier where 1.0 = no change, <1 = darker, >1 = brighter",
                    "nullable": true,
                    "type": "number"
                  },
                  "contrast": {
                    "description": "(Optional) For 'contrast' operation: multiplier where 1.0 = no change, <1 = less contrast, >1 = more contrast",
                    "nullable": true,
                    "type": "number"
                  }
                },
                "required": [
                  "file_path",
                  "image_index",
                  "operation"
                ],
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "422": {
            "description": "Invalid operation input"
          }
        }
      }
    },
    "/documents/apply_formatting": {
      "post": {
        "operationId": "apply_formatting",
        "summary": "Apply formatting",
        "description": "Apply text styling attributes to a run, paragraph, or cell selected by identifier.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file_path": {
                    "type": "string",
                    "format": "binary",
                    "description": "Office file upload"
                  },
                  "identifier": {
                    "description": "Stable identifier from read_document_content for element to format (e.g., 'body.p.0' applies to all runs in paragraph)",
                    "type": "string"
                  },
                  "bold": {
                    "description": "(Optional) Set bold formatting: true to enable, false to disable, null/omit to leave unchanged",
                    "nullable": true,
                    "type": "boolean"
                  },
                  "italic": {
                    "description": "(Optional) Set italic formatting: true to enable, false to disable, null/omit to leave unchanged",
                    "nullable": true,
                    "type": "boolean"
                  },
                  "underline": {
                    "description": "(Optional) Set underline formatting: true to enable, false to disable, null/omit to leave unchanged",
                    "nullable": true,
                    "type": "boolean"
                  },
                  "strikethrough": {
                    "description": "(Optional) Set strikethrough formatting: true to enable, false to disable, null/omit to leave unchanged",
                    "nullable": true,
                    "type": "boolean"
                  },
                  "font_size": {
                    "description": "(Optional) Font size in points (e.g., 12, 14.5); null/omit to leave unchanged (Union of: number, integer)",
                    "nullable": true,
                    "type": "number"
                  },
                  "font_color": {
                    "description": "(Optional) Font color as 6-character hex RGB string (e.g., 'FF0000' for red, '0000FF' for blue); with or without '#' prefix",
                    "nullable": true,
                    "type": "string"
                  }
                },
                "required": [
                  "file_path",
                  "identifier"
                ],
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "422": {
            "description": "Invalid operation input"
          }
        }
      }
    },
    "/documents/header_footer": {
      "post": {
        "operationId": "header_footer",
        "summary": "Header footer",
        "description": "Read or set header/footer content (action-based). Use for header/footer content.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file_path": {
                    "type": "string",
                    "format": "binary",
                    "description": "Office file upload"
                  },
                  "action": {
                    "description": "Action to perform: 'read' (get content), 'set' (replace content), 'clear' (remove all content), or 'link' (link to previous section)",
                    "type": "string"
                  },
                  "area": {
                    "description": "Target area: 'header' or 'footer'",
                    "type": "string"
                  },
                  "section_index": {
                    "description": "(Optional) 0-based index of document section to modify; default 0 (first section)",
                    "nullable": true,
                    "type": "integer"
                  },
                  "content": {
                    "description": "(Optional) For 'set' action: list of content blocks (same format as create_document); required for 'set', ignored otherwise",
                    "nullable": true,
                    "items": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/ParagraphBlock"
                        },
                        {
                          "$ref": "#/components/schemas/HeadingBlock"
                        },
                        {
                          "$ref": "#/components/schemas/BulletListBlock"
                        },
                        {
                          "$ref": "#/components/schemas/NumberedListBlock"
                        },
                        {
                          "$ref": "#/components/schemas/TableBlock"
                        },
                        {
                          "$ref": "#/components/schemas/PageBreakBlock"
                        },
                        {
                          "$ref": "#/components/schemas/SectionBreakBlock"
                        }
                      ]
                    },
                    "type": "array"
                  },
                  "link_to_previous": {
                    "description": "(Optional) For 'link' action: true to link to previous section's header/footer, false to unlink; required for 'link', ignored otherwise",
                    "nullable": true,
                    "type": "boolean"
                  }
                },
                "required": [
                  "file_path",
                  "action",
                  "area"
                ],
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "422": {
            "description": "Invalid operation input"
          }
        }
      }
    },
    "/documents/page_margins": {
      "post": {
        "operationId": "page_margins",
        "summary": "Page margins",
        "description": "Set page margins. Use to adjust layout.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file_path": {
                    "type": "string",
                    "format": "binary",
                    "description": "Office file upload"
                  },
                  "action": {
                    "description": "Action to perform: 'read' (get current margins) or 'set' (modify margins)",
                    "type": "string"
                  },
                  "section_index": {
                    "description": "(Optional) 0-based index of document section to read/modify; default 0 (first section)",
                    "nullable": true,
                    "type": "integer"
                  },
                  "top": {
                    "description": "(Optional) For 'set' action: top margin in inches (e.g., 1.0); null to leave unchanged",
                    "nullable": true,
                    "type": "number"
                  },
                  "bottom": {
                    "description": "(Optional) For 'set' action: bottom margin in inches (e.g., 1.0); null to leave unchanged",
                    "nullable": true,
                    "type": "number"
                  },
                  "left": {
                    "description": "(Optional) For 'set' action: left margin in inches (e.g., 1.25); null to leave unchanged",
                    "nullable": true,
                    "type": "number"
                  },
                  "right": {
                    "description": "(Optional) For 'set' action: right margin in inches (e.g., 1.25); null to leave unchanged",
                    "nullable": true,
                    "type": "number"
                  }
                },
                "required": [
                  "file_path",
                  "action"
                ],
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "422": {
            "description": "Invalid operation input"
          }
        }
      }
    },
    "/documents/page_orientation": {
      "post": {
        "operationId": "page_orientation",
        "summary": "Page orientation",
        "description": "Set page orientation (portrait/landscape). Use to change orientation.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file_path": {
                    "type": "string",
                    "format": "binary",
                    "description": "Office file upload"
                  },
                  "action": {
                    "description": "Action to perform: 'read' (get current orientation) or 'set' (change orientation)",
                    "type": "string"
                  },
                  "section_index": {
                    "description": "(Optional) 0-based index of document section to read/modify; default 0 (first section)",
                    "nullable": true,
                    "type": "integer"
                  },
                  "orientation": {
                    "description": "(Optional) For 'set' action: target orientation 'portrait' or 'landscape'; required for 'set', ignored for 'read'",
                    "nullable": true,
                    "type": "string"
                  }
                },
                "required": [
                  "file_path",
                  "action"
                ],
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "422": {
            "description": "Invalid operation input"
          }
        }
      }
    },
    "/documents/comments": {
      "post": {
        "operationId": "comments",
        "summary": "Comments",
        "description": "Read, add, or delete comments (action: read | add | delete). Use for document comments.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file_path": {
                    "type": "string",
                    "format": "binary",
                    "description": "Office file upload"
                  },
                  "action": {
                    "description": "Action to perform: 'read' (list all comments), 'add' (create new comment), or 'delete' (remove comment by ID)",
                    "type": "string"
                  },
