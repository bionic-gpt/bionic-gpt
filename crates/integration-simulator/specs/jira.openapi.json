{
  "info": {
    "title": "Jira",
    "x-logo": {
      "url": "https://cdn.simpleicons.org/jira"
    },
    "version": "v3",
    "description": "Simulated Jira API for deterministic issue tracking workflow evaluations."
  },
  "paths": {
    "/rest/api/3/issue": {
      "post": {
        "summary": "Submit a new Jira issue. Requires a project key, issue type, and summary. Priority is optional (Highest, High, Medium, Low, Lowest).",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "key": {
                      "type": "string"
                    },
                    "self": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "description": "{id, key (e.g. PROJ-42), self}"
          }
        },
        "description": "Submit a new Jira issue. Requires a project key, issue type, and summary. Priority is optional (Highest, High, Medium, Low, Lowest). Request body: Body: {fields: {project: {key: 'PROJ'} (required), issuetype: {name: 'Task'} (required — 'Bug', 'Task', 'Story', 'Epic', etc.), summary: 'issue title' (required), priority: {name: 'High'} (optional — 'Highest'|'High'|'Medium'|'Low'|'Lowest'), description: {type: 'doc', version: 1, content: [...]} (optional — ADF format)}}.",
        "operationId": "jira.issues.create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "fields"
                ],
                "properties": {
                  "fields": {
                    "type": "object",
                    "required": [
                      "project",
                      "issuetype",
                      "summary"
                    ],
                    "properties": {
                      "project": {
                        "type": "object",
                        "properties": {
                          "key": {
                            "type": "string"
                          }
                        }
                      },
                      "summary": {
                        "type": "string"
                      },
                      "priority": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          }
                        }
                      },
                      "issuetype": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          }
                        }
                      },
                      "description": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string"
                          },
                          "content": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "...": {
                                  "type": "string"
                                }
                              }
                            }
                          },
                          "version": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                },
                "description": "Body: {fields: {project: {key: 'PROJ'} (required), issuetype: {name: 'Task'} (required — 'Bug', 'Task', 'Story', 'Epic', etc.), summary: 'issue title' (required), priority: {name: 'High'} (optional — 'Highest'|'High'|'Medium'|'Low'|'Lowest'), description: {type: 'doc', version: 1, content: [...]} (optional — ADF format)}}"
              }
            }
          },
          "required": true
        }
      }
    },
    "/rest/api/3/project/search": {
      "get": {
        "summary": "Query Jira projects by name or key. Returns the project key required when creating new issues.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": {
                      "type": "string"
                    },
                    "isLast": {
                      "type": "string"
                    },
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "key": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "projectTypeKey": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "description": "{values: [{id, key, name, projectTypeKey}], total, isLast}"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "query",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Text to match against project name or key."
          },
          {
            "in": "query",
            "name": "maxResults",
            "schema": {
              "type": "integer"
            },
            "required": false,
            "description": "Maximum number of results to return (default 50)."
          }
        ],
        "description": "Query Jira projects by name or key. Returns the project key required when creating new issues.",
        "operationId": "jira.projects.search"
      }
    },
    "/rest/api/3/issue/{issueIdOrKey}/comment": {
      "post": {
        "summary": "Post a comment on a Jira issue. Provide plain text and it will be automatically converted to ADF format.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "body": {
                      "type": "string"
                    },
                    "author": {
                      "type": "object",
                      "properties": {
                        "accountId": {
                          "type": "string"
                        },
                        "displayName": {
                          "type": "string"
                        }
                      }
                    },
                    "created": {
                      "type": "string"
                    },
                    "updated": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "description": "{id, body, created, updated, author: {displayName, accountId}}"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "issueIdOrKey",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Issue key (e.g. PROJ-42) or numeric issue ID."
          }
        ],
        "description": "Post a comment on a Jira issue. Provide plain text and it will be automatically converted to ADF format. Request body: Body: {body (required, string — plain text comment body, automatically wrapped in ADF format)}.",
        "operationId": "jira.issues.comment",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "body"
                ],
                "properties": {
                  "body": {
                    "type": "string"
                  }
                },
                "description": "Body: {body (required, string — plain text comment body, automatically wrapped in ADF format)}"
              }
            }
          },
          "required": true
        }
      }
    }
  },
  "openapi": "3.1.0",
  "servers": [
    {
      "url": "http://integration-simulator:8080/api/jira"
    }
  ],
  "components": {
    "schemas": {
      "Issue": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Numeric identifier for the issue."
          },
          "key": {
            "type": "string",
            "description": "Issue key in the format PROJ-42."
          },
          "self": {
            "type": "string",
            "description": "API URL pointing to this issue."
          },
          "fields": {
            "type": "object",
            "properties": {
              "status": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  }
                }
              },
              "project": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                }
              },
              "summary": {
                "type": "string"
              },
              "priority": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  }
                }
              },
              "issuetype": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  }
                }
              },
              "description": {
                "type": "object",
                "description": "Issue description in Atlassian Document Format (ADF)."
              }
            }
          }
        }
      },
      "Comment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "body": {
            "type": "object",
            "description": "Comment body in ADF format."
          },
          "author": {
            "type": "object",
            "properties": {
              "accountId": {
                "type": "string"
              },
              "displayName": {
                "type": "string"
              }
            }
          },
          "created": {
            "type": "string",
            "format": "date-time"
          },
          "updated": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "key": {
            "type": "string",
            "description": "Abbreviated project key, e.g. 'PROJ'."
          },
          "name": {
            "type": "string"
          },
          "projectTypeKey": {
            "type": "string",
            "description": "software, business, or service_desk."
          }
        }
      }
    }
  }
}
