                  },
                  "item_name": {
                    "type": "string"
                  },
                  "column_values (optional, JSON string — initial column values as a JSON object mapping column IDs to values, e.g. '{\"status\"": {
                    "type": "string"
                  }
                },
                "description": "Body: {board_id (required, string — board ID), item_name (required, string — name for the new item), group_id (optional, string — group/section ID to place the item in), column_values (optional, JSON string — initial column values as a JSON object mapping column IDs to values, e.g. '{\"status\":\"Done\",\"date4\":\"2024-01-15\"}')}"
              }
            }
          },
          "required": true
        }
