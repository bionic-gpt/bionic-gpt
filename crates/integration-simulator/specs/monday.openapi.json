                  "board_id": {
                    "type": "string"
                  },
                  "column_id": {
                    "type": "string"
                  },
                  "column_type (optional, string": {
                    "type": "string",
                    "format": "date"
                  }
                },
                "description": "Body: {board_id (required, string — board ID), column_id (required, string — column internal ID), value (required, string — new value; for status use the label text, for date use YYYY-MM-DD, for number use a numeric string), column_type (optional, string: 'status'|'date'|'number'|'text' — helps route to the correct update function)}"
              }
            }
          },
          "required": true
        }
      }
