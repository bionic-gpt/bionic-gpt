    "/items/{itemId}/columns:update": {
      "post": {
        "summary": "Set a column value for an item. Use column_type to indicate the kind of column: 'status' for status/dropdown columns, 'date' for date columns (value: YYYY-MM-DD), 'number' for numeric columns, 'text' for text columns.",
        "responses": {
          "200": {
            "content": {
