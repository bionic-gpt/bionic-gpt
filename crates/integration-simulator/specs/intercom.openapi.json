  "paths": {
    "/tags": {
      "post": {
        "summary": "Apply a tag to an Intercom company. Assign a label to an organization. Operates via the shared tags endpoint.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "description": "Tag object with tagged companies"
          }
        },
        "description": "Apply a tag to an Intercom company. Assign a label to an organization. Operates via the shared tags endpoint. Request body: {name: string (tag name), companies: [{id: string (company ID)}]}.",
        "operationId": "intercom.companies.tag",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "companies": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "description": "{name: string (tag name), companies: [{id: string (company ID)}]}"
              }
            }
          },
          "required": true
        }
      }
    },
