  "servers": [
    {
      "url": "http://integration-simulator:8080/api/canva"
    }
  ],
  "components": {
    "schemas": {
      "Asset": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
