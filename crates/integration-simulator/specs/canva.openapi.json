          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "type": {
            "enum": [
              "image",
              "video"
            ],
            "type": "string"
          },
          "owner": {
            "type": "object",
            "properties": {
              "team_id": {
                "type": "string"
              },
              "user_id": {
                "type": "string"
              }
            }
          },
          "thumbnail": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string"
              },
              "width": {
                "type": "integer"
              },
              "height": {
                "type": "integer"
              }
            }
          },
          "created_at": {
            "type": "integer"
          },
          "updated_at": {
            "type": "integer"
          }
        },
        "description": "A media asset stored in Canva (image or video)."
      },
      "Design": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the design."
          },
          "urls": {
            "type": "object",
            "properties": {
              "edit_url": {
                "type": "string",
                "description": "Link to open the design in the editor (valid for 30 days)."
              },
              "view_url": {
                "type": "string",
                "description": "Link to preview the design (valid for 30 days)."
              }
            }
          },
          "owner": {
            "type": "object",
            "properties": {
              "team_id": {
                "type": "string"
              },
              "user_id": {
                "type": "string"
              }
            }
          },
          "title": {
            "type": "string",
            "description": "Name of the design (1–255 characters)."
          },
          "thumbnail": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "description": "URL of the design thumbnail image (expires after 15 minutes)."
              },
              "width": {
                "type": "integer"
              },
              "height": {
                "type": "integer"
              }
            }
          },
          "created_at": {
            "type": "integer",
            "description": "Creation time as a Unix timestamp in seconds."
          },
          "page_count": {
            "type": "integer",
            "description": "Total number of pages in the design (optional)."
          },
          "updated_at": {
            "type": "integer",
            "description": "Last modification time as a Unix timestamp in seconds."
          }
        },
        "description": "Represents a Canva design."
      },
      "ExportJob": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the export job."
          },
          "urls": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Download URLs for exported files upon success (one per page, expire after 24 hours)."
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "enum": [
                  "license_required",
                  "approval_required",
                  "internal_failure"
                ],
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          },
          "status": {
            "enum": [
              "in_progress",
              "success",
              "failed"
            ],
            "type": "string"
          }
        },
        "description": "Represents an ongoing or completed design export job."
      },
      "AssetUploadJob": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "asset": {
            "$ref": "#/components/schemas/Asset"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "enum": [
                  "file_too_big",
                  "import_failed",
                  "fetch_failed"
                ],
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          },
          "status": {
            "enum": [
              "in_progress",
              "success",
              "failed"
            ],
            "type": "string"
          }
        },
        "description": "Represents a job for uploading an asset to Canva."
      }
    }
  }
