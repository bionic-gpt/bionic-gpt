  "components": {
    "schemas": {
      "Usage": {
        "type": "object",
        "properties": {
          "total_tokens": {
            "type": "integer"
          },
          "prompt_tokens": {
            "type": "integer"
          },
          "completion_tokens": {
            "type": "integer"
          }
        }
      },
      "ChatMessage": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "An optional identifier for the participant sending this message."
          },
          "role": {
            "enum": [
              "system",
              "developer",
              "user",
              "assistant",
              "tool"
            ],
            "type": "string",
            "description": "The role of the entity authoring this message. 'developer' is the updated alias for 'system'. 'tool' is used when supplying tool call results."
          },
          "content": {
            "type": "string",
            "description": "The text content of the message."
          }
        }
      },
      "ResponseOutput": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "enum": [
              "assistant"
            ],
            "type": "string"
          },
          "type": {
            "enum": [
              "message",
              "function_call"
            ],
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "content": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "output_text"
                  ],
                  "type": "string"
                },
                "annotations": {
                  "type": "array"
                }
              }
            }
          }
        },
        "description": "A single output item produced by the Responses API."
      },
      "CompletionChoice": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "index": {
            "type": "integer"
          },
          "logprobs": {
            "type": [
              "object",
              "null"
            ]
          },
          "finish_reason": {
            "enum": [
              "stop",
              "length"
            ],
            "type": "string"
          }
        }
      },
      "ModerationResult": {
        "type": "object",
        "properties": {
          "flagged": {
            "type": "boolean",
            "description": "Indicates whether the input content was found to violate any policy category."
          },
          "categories": {
            "type": "object",
            "properties": {
              "hate": {
                "type": "boolean"
              },
              "sexual": {
                "type": "boolean"
              },
              "illicit": {
                "type": "boolean"
              },
              "violence": {
                "type": "boolean"
              },
              "self-harm": {
                "type": "boolean"
              },
              "harassment": {
                "type": "boolean"
              },
              "sexual/minors": {
                "type": "boolean"
              },
              "illicit/violent": {
                "type": "boolean"
              },
              "hate/threatening": {
                "type": "boolean"
              },
              "self-harm/intent": {
                "type": "boolean"
              },
              "violence/graphic": {
                "type": "boolean"
              },
              "harassment/threatening": {
                "type": "boolean"
              },
              "self-harm/instructions": {
                "type": "boolean"
              }
