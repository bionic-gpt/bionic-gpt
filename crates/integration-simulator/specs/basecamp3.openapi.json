{
  "info": {
    "title": "Basecamp3",
    "version": "v1",
    "description": "Simulated Basecamp3 API for deterministic AutomationBench workflow evaluation."
  },
  "paths": {
    "/{accountId}/buckets/{projectId}/todosets/{todoSetId}/todolists/{todolistId}/todos": {
      "post": {
        "summary": "Add a new to-do item within a specific todolist. The accountId, projectId, todoSetId, and todolistId must be known ahead of time (they can be found via the Basecamp UI or API). The todoset ID is available from the project's dock.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "type": {
                      "$ref": "#/components/schemas/Todo"
                    },
                    "status": {
                      "type": "string"
                    },
                    "content": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "description": "{id, content, status: 'active', type: 'Todo'}"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "accountId",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Numeric Basecamp account identifier."
          },
          {
            "in": "path",
            "name": "projectId",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Identifier for the project (bucket)."
          },
          {
            "in": "path",
            "name": "todoSetId",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Identifier for the todoset within the project."
          },
          {
            "in": "path",
            "name": "todolistId",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Identifier for the todolist within the todoset."
          }
        ],
        "description": "Add a new to-do item within a specific todolist. The accountId, projectId, todoSetId, and todolistId must be known ahead of time (they can be found via the Basecamp UI or API). The todoset ID is available from the project's dock. Request body: Body: {content (required, string — the to-do item text/title), due_on (optional, string — due date in YYYY-MM-DD format)}.",
        "operationId": "basecamp3.todos.create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "content"
                ],
                "properties": {
                  "due_on": {
                    "type": "string",
                    "format": "date"
                  },
                  "content": {
                    "type": "string"
                  }
                },
                "description": "Body: {content (required, string — the to-do item text/title), due_on (optional, string — due date in YYYY-MM-DD format)}"
              }
            }
          },
          "required": true
        }
      }
    }
  },
  "openapi": "3.1.0",
  "servers": [
    {
      "url": "http://integration-simulator:8080/api/basecamp3"
    }
  ],
  "components": {
    "schemas": {
      "Todo": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Unique numeric identifier for the todo."
          },
          "type": {
            "type": "string",
            "description": "Resource type; always 'Todo'."
          },
          "due_on": {
            "type": "string",
            "format": "date",
            "description": "Deadline for the todo in YYYY-MM-DD format."
          },
          "status": {
            "enum": [
              "active",
              "completed"
            ],
            "type": "string",
            "description": "Whether the todo is currently active or has been completed."
          },
          "content": {
            "type": "string",
            "description": "Title or body text of the task."
          }
        },
        "description": "A Basecamp 3 to-do task item."
      }
    }
  }
}
