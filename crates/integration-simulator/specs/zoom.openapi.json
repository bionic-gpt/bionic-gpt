    "/meetings/{meetingId}/registrants": {
      "get": {
        "summary": "Retrieve all registrants and participants for a Zoom meeting, with optional filtering by approval status.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "page_size": {
                      "type": "string"
                    },
                    "page_count": {
                      "type": "string"
                    },
                    "registrants": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "email": {
                            "type": "string",
                            "format": "email"
                          },
                          "status": {
                            "type": "string"
                          },
                          "join_url": {
                            "type": "string"
                          },
                          "last_name": {
                            "type": "string"
                          },
                          "first_name": {
                            "type": "string"
                          },
                          "create_time": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "participants": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "Participant": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "total_records": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "description": "{page_count, page_size, total_records, registrants: [{id, email, first_name, last_name, status, create_time, join_url}], participants: [Participant]}"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "meetingId",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "The identifier of the target meeting."
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "enum": [
                "pending",
                "approved",
                "denied"
              ],
              "type": "string"
            },
            "required": false,
            "description": "Restrict results to registrants with this approval status."
          }
        ],
        "description": "Retrieve all registrants and participants for a Zoom meeting, with optional filtering by approval status.",
        "operationId": "zoom.meetings.registrants.list"
      },
      "post": {
