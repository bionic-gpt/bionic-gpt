{
  "info": {
    "title": "Zoom",
    "x-logo": {
      "url": "https://cdn.simpleicons.org/zoom"
    },
    "version": "v2",
    "description": "Simulated Zoom API for deterministic meeting workflow evaluations."
  },
  "paths": {
    "/meetings/{meetingId}": {
      "get": {
        "summary": "Retrieve the full details of a specific Zoom meeting using its ID.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    },
                    "uuid": {
                      "type": "string"
                    },
                    "topic": {
                      "type": "string"
                    },
                    "agenda": {
                      "type": "string"
                    },
                    "host_id": {
                      "type": "string"
                    },
                    "duration": {
                      "type": "string"
                    },
                    "join_url": {
                      "type": "string"
                    },
                    "password": {
                      "type": "string"
                    },
                    "timezone": {
                      "type": "string"
                    },
                    "created_at": {
                      "type": "string"
                    },
                    "start_time": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "description": "{uuid, id, host_id, topic, type, start_time, duration, timezone, created_at, agenda, join_url, password}"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "meetingId",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "The identifier of the target meeting."
          }
        ],
        "description": "Retrieve the full details of a specific Zoom meeting using its ID.",
        "operationId": "zoom.meetings.get"
      },
      "patch": {
        "summary": "Modify an existing Zoom meeting. Only the fields provided in the request body are changed.",
        "responses": {
          "204": {
            "description": "204 No Content on success (empty JSON object)"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "meetingId",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "The identifier of the meeting to update."
          }
        ],
        "description": "Modify an existing Zoom meeting. Only the fields provided in the request body are changed. Request body: Body (all optional): {topic, type (1, 2, 3, or 8), start_time, duration, timezone, password (passcode), agenda}.",
        "operationId": "zoom.meetings.update",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "topic": {
                    "type": "string"
                  },
                  "agenda": {
                    "type": "string"
                  },
                  "duration": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "timezone": {
                    "type": "string"
                  },
                  "start_time": {
                    "type": "string"
                  }
                },
                "description": "Body (all optional): {topic, type (1, 2, 3, or 8), start_time, duration, timezone, password (passcode), agenda}"
              }
            }
          },
          "required": false
        }
      }
    },
    "/users/{userId}/meetings": {
      "get": {
        "summary": "Retrieve all meetings for a given user, including upcoming and past sessions. Supports filtering by meeting type.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "meetings": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string"
                          },
                          "uuid": {
                            "type": "string"
                          },
                          "topic": {
                            "type": "string"
                          },
                          "host_id": {
                            "type": "string"
                          },
                          "duration": {
                            "type": "string"
                          },
                          "join_url": {
                            "type": "string"
                          },
                          "timezone": {
                            "type": "string"
                          },
                          "created_at": {
                            "type": "string"
                          },
                          "start_time": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "page_size": {
                      "type": "string"
                    },
                    "page_count": {
                      "type": "string"
                    },
                    "page_number": {
                      "type": "string"
                    },
                    "total_records": {
                      "type": "string"
                    },
                    "next_page_token": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "description": "{page_count, page_number, page_size, total_records, next_page_token, meetings: [{uuid, id, host_id, topic, type, start_time, duration, timezone, created_at, join_url}]}"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "userId",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "The user's ID or email address. Use 'me' to refer to the currently authenticated user."
          },
          {
            "in": "query",
            "name": "type",
            "schema": {
              "enum": [
                "scheduled",
                "live",
                "upcoming"
              ],
              "type": "string"
            },
            "required": false,
            "description": "Type of meetings to return: scheduled, live, or upcoming (default 'live')."
          },
          {
            "in": "query",
            "name": "page_size",
            "schema": {
              "type": "integer"
            },
            "required": false,
            "description": "How many records to include per page (default 30, maximum 300)."
          },
          {
            "in": "query",
            "name": "next_page_token",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Pagination cursor to fetch the following page of results."
          },
          {
            "in": "query",
            "name": "page_number",
            "schema": {
              "type": "integer"
            },
            "required": false,
            "description": "Page index to return (deprecated; use next_page_token instead)."
          }
        ],
        "description": "Retrieve all meetings for a given user, including upcoming and past sessions. Supports filtering by meeting type.",
        "operationId": "zoom.users.meetings.list"
      },
      "post": {
        "summary": "Schedule a new Zoom meeting for the specified user.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "description": "201 Created: {uuid, id, host_id, topic, type, start_time, duration, timezone, created_at, agenda, join_url, password}"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "userId",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "The user's ID or email address. Use 'me' to refer to the currently authenticated user."
          }
        ],
        "description": "Schedule a new Zoom meeting for the specified user. Request body: Body: {topic (string), type (integer: 1=instant, 2=scheduled, 3=recurring no fixed time, 8=recurring fixed time; default 2), start_time (ISO 8601 UTC), duration (minutes, default 60), timezone (string, e.g. 'America/Los_Angeles'), password (string, max 10 chars — meeting passcode), agenda (string), host_email (string), registration_required (boolean), settings: {approval_type (0=auto approve, 1=manual), waiting_room (boolean)}}.",
        "operationId": "zoom.users.meetings.create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "topic": {
                    "type": "string"
                  },
                  "agenda": {
                    "type": "string"
                  },
                  "duration": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "settings": {
                    "type": "object",
                    "properties": {
                      "waiting_room": {
                        "type": "boolean"
                      },
                      "approval_type": {
                        "type": "string"
                      }
                    }
                  },
                  "timezone": {
                    "type": "string"
                  },
                  "host_email": {
                    "type": "string",
                    "format": "email"
                  },
                  "start_time": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "type (integer": {
                    "type": "string"
                  },
                  "registration_required": {
                    "type": "boolean"
                  }
                },
                "description": "Body: {topic (string), type (integer: 1=instant, 2=scheduled, 3=recurring no fixed time, 8=recurring fixed time; default 2), start_time (ISO 8601 UTC), duration (minutes, default 60), timezone (string, e.g. 'America/Los_Angeles'), password (string, max 10 chars — meeting passcode), agenda (string), host_email (string), registration_required (boolean), settings: {approval_type (0=auto approve, 1=manual), waiting_room (boolean)}}"
              }
            }
          },
          "required": true
        }
      }
    },
